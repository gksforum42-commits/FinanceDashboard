@{
    ViewData["Title"] = "Dashboard";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
            <p class="text-muted mb-0">Budget Analysis Overview - Finance Department Punjab</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="financialYearFilter" class="form-select form-select-sm" style="width: 150px;">
                <option value="">-- All Years --</option>
            </select>
            <button class="btn btn-outline-primary btn-sm" onclick="loadDashboardSummary($('#financialYearFilter').val() ? parseInt($('#financialYearFilter').val()) : null)">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Summary Cards Row 1 — Allocated Budget by Sector (FinalGrant) -->
    <div class="summary-cards-row">
        <div class="summary-card primary">
            <div class="card-icon"><i class="bi bi-building"></i></div>
            <div class="card-value" id="nonDevelopmentBudget">PKR 0.00</div>
            <div class="card-label">Non Development</div>
        </div>
        <div class="summary-card info">
            <div class="card-icon"><i class="bi bi-cash-coin"></i></div>
            <div class="card-value" id="capitalAc1Budget">PKR 0.00</div>
            <div class="card-label">Capital-A/c-I</div>
        </div>
        <div class="summary-card success">
            <div class="card-icon"><i class="bi bi-bank"></i></div>
            <div class="card-value" id="capitalAc2Budget">PKR 0.00</div>
            <div class="card-label">Capital-A/c-II</div>
        </div>
        <div class="summary-card warning">
            <div class="card-icon"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="card-value" id="developmentBudget">PKR 0.00</div>
            <div class="card-label">Development</div>
        </div>
    </div>

    <!-- Total Row -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <small class="text-muted">Total Allocated Budget (All Sectors)</small>
                                <div class="fs-4 fw-bold text-primary" id="totalFinalGrant">PKR 0.00</div>
                            </div>
                    <i class="bi bi-cash-stack fs-2 text-primary opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-muted">Total Expenditure (All Sectors)</small>
                        <div class="fs-4 fw-bold text-success" id="totalActualExpenditure">PKR 0.00</div>
                    </div>
                    <i class="bi bi-cash-coin fs-2 text-success opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="dashboard-charts">
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-pie-chart me-2"></i>Budget Distribution by Fund</span>
            </div>
            <div class="chart-container-sm">
                <canvas id="summaryPieChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-bar-chart me-2"></i>Monthly Expenditure Trend</span>
            </div>
            <div class="chart-container-sm">
                <canvas id="expenditureChart"></canvas>
            </div>
        </div>
    </div>


</div>

@section Scripts {
}
