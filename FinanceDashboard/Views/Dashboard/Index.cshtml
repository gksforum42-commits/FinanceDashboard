@{
    ViewData["Title"] = "Dashboard";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
            <p class="text-muted mb-0">Budget &amp; Expenditure Data &mdash; Last Updated: <strong id="berLastUpdatedText" class="text-dark">—</strong></p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="financialYearFilter" class="form-select form-select-sm" style="width: 150px;">
                <option value="">-- All Years --</option>
            </select>
            <button class="btn btn-outline-primary btn-sm" onclick="loadDashboardSummary($('#financialYearFilter').val() ? parseInt($('#financialYearFilter').val()) : null)">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Summary Cards Row 1 — Allocated Budget by Sector (FinalGrant) -->
    <div class="summary-cards-row">

        <!-- Non Development -->
        <div class="rich-card rc-primary">
            <div class="rc-budget-row">
                <div class="rc-budget" id="nonDevelopmentBudget">PKR 0.00</div>
                <div class="rc-icon rc-icon-primary"><i class="bi bi-building"></i></div>
            </div>
            <div class="rc-label">Non Development</div>
            <div class="rc-divider"></div>
            <div class="rc-stats">
                <div class="rc-stat">
                    <div class="rc-stat-label">Release</div>
                    <div class="rc-stat-value" id="nonDevelopmentRelease">—</div>
                </div>
                <div class="rc-stat">
                    <div class="rc-stat-label">Expenditure</div>
                    <div class="rc-stat-value" id="nonDevelopmentExpenditure">—</div>
                </div>
            </div>
            <div class="rc-used-row">
                <span class="rc-used-label">Used</span>
                <span class="rc-used-pct rc-used-primary" id="nonDevelopmentUsedPct">&lt;0.1%</span>
            </div>
            <div class="rc-progress-track">
                <div class="rc-progress-bar rc-bar-primary" id="nonDevelopmentBar" style="width:0%"></div>
            </div>
        </div>

        <!-- Capital-A/c-I -->
        <div class="rich-card rc-info">
            <div class="rc-budget-row">
                <div class="rc-budget" id="capitalAc1Budget">PKR 0.00</div>
                <div class="rc-icon rc-icon-info"><i class="bi bi-arrow-left-right"></i></div>
            </div>
            <div class="rc-label">Capital-a/c-i</div>
            <div class="rc-divider"></div>
            <div class="rc-stats">
                <div class="rc-stat">
                    <div class="rc-stat-label">Release</div>
                    <div class="rc-stat-value" id="capitalAc1Release">—</div>
                </div>
                <div class="rc-stat">
                    <div class="rc-stat-label">Expenditure</div>
                    <div class="rc-stat-value" id="capitalAc1Expenditure">—</div>
                </div>
            </div>
            <div class="rc-used-row">
                <span class="rc-used-label">Used</span>
                <span class="rc-used-pct rc-used-info" id="capitalAc1UsedPct">&lt;0.1%</span>
            </div>
            <div class="rc-progress-track">
                <div class="rc-progress-bar rc-bar-info" id="capitalAc1Bar" style="width:0%"></div>
            </div>
        </div>

        <!-- Capital-A/c-II -->
        <div class="rich-card rc-success">
            <div class="rc-budget-row">
                <div class="rc-budget" id="capitalAc2Budget">PKR 0.00</div>
                <div class="rc-icon rc-icon-success"><i class="bi bi-bank"></i></div>
            </div>
            <div class="rc-label">Capital-a/c-ii</div>
            <div class="rc-divider"></div>
            <div class="rc-stats">
                <div class="rc-stat">
                    <div class="rc-stat-label">Release</div>
                    <div class="rc-stat-value" id="capitalAc2Release">—</div>
                </div>
                <div class="rc-stat">
                    <div class="rc-stat-label">Expenditure</div>
                    <div class="rc-stat-value" id="capitalAc2Expenditure">—</div>
                </div>
            </div>
            <div class="rc-used-row">
                <span class="rc-used-label">Used</span>
                <span class="rc-used-pct rc-used-success" id="capitalAc2UsedPct">&lt;0.1%</span>
            </div>
            <div class="rc-progress-track">
                <div class="rc-progress-bar rc-bar-success" id="capitalAc2Bar" style="width:0%"></div>
            </div>
        </div>

        <!-- Development -->
        <div class="rich-card rc-warning">
            <div class="rc-budget-row">
                <div class="rc-budget" id="developmentBudget">PKR 0.00</div>
                <div class="rc-icon rc-icon-warning"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
            <div class="rc-label">Development</div>
            <div class="rc-divider"></div>
            <div class="rc-stats">
                <div class="rc-stat">
                    <div class="rc-stat-label">Release</div>
                    <div class="rc-stat-value" id="developmentRelease">—</div>
                </div>
                <div class="rc-stat">
                    <div class="rc-stat-label">Expenditure</div>
                    <div class="rc-stat-value" id="developmentExpenditure">—</div>
                </div>
            </div>
            <div class="rc-used-row">
                <span class="rc-used-label">Used</span>
                <span class="rc-used-pct rc-used-warning" id="developmentUsedPct">&lt;0.1%</span>
            </div>
            <div class="rc-progress-track">
                <div class="rc-progress-bar rc-bar-warning" id="developmentBar" style="width:0%"></div>
            </div>
        </div>

    </div>

    <!-- Total Row -->
    <div class="totals-row mb-4">

        <!-- Total Allocated Budget -->
        <div class="total-card tc-blue">
            <div class="tc-header">
                <div class="tc-title">Total allocated budget</div>
                <div class="tc-icon tc-icon-blue"><i class="bi bi-bank"></i></div>
            </div>
            <div class="tc-value" id="totalFinalGrant">PKR 0.00</div>
            <div class="tc-progress-row">
                <span class="tc-progress-label">Released against allocation</span>
                <span class="tc-progress-pct tc-pct-blue" id="releasedAgainstAllocationPct">0%</span>
            </div>
            <div class="tc-progress-track">
                <div class="tc-progress-bar tc-bar-blue" id="releasedAgainstAllocationBar" style="width:0%"></div>
            </div>
            <div class="tc-footer">
                <span class="tc-footer-left" id="totalReleasedLabel">Released: PKR 0.00</span>
                <span class="tc-footer-right" id="sectorsFundedLabel">0 sectors funded</span>
            </div>
        </div>

        <!-- Total Expenditure -->
        <div class="total-card tc-red">
            <div class="tc-header">
                <div class="tc-title">Total expenditure</div>
                <div class="tc-icon tc-icon-red"><i class="bi bi-clipboard2-data"></i></div>
            </div>
            <div class="tc-value tc-value-red" id="totalActualExpenditure">PKR 0.00</div>
            <div class="tc-progress-row">
                <span class="tc-progress-label">Spent against released</span>
                <span class="tc-progress-pct tc-pct-red" id="spentAgainstReleasedPct">0%</span>
            </div>
            <div class="tc-progress-track">
                <div class="tc-progress-bar tc-bar-red" id="spentAgainstReleasedBar" style="width:0%"></div>
            </div>
            <div class="tc-footer">
                <span class="tc-footer-left" id="spentAgainstAllocationLabel">Spent against total allocation: 0%</span>
            </div>
        </div>

    </div>

    <!-- Charts Section -->
    <div class="dashboard-charts">
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-pie-chart me-2"></i>Budget Distribution by Fund</span>
            </div>
            <div class="chart-container-sm">
                <canvas id="summaryPieChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-header">
                <span class="chart-title"><i class="bi bi-bar-chart me-2"></i>Monthly Expenditure Trend</span>
            </div>
            <div class="chart-container-sm">
                <canvas id="expenditureChart"></canvas>
            </div>
        </div>
    </div>


</div>

@section Scripts {
}
