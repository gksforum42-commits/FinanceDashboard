@{
    ViewData["Title"] = "Department Wise Report";
}

<div class="fade-in" id="reportWrapper">

    <!-- Page Header -->
    <div class="page-header no-print">
        <div>
            <h2 class="page-title"><i class="bi bi-diagram-3 me-2"></i>Department Wise Report</h2>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-success btn-sm me-1" onclick="exportExcelReport()">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel (Full Report)
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportPdfReport()">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF (Full Report)
            </button>
        </div>
    </div>

    <!-- Print Header -->
    <div class="print-only mb-3">
        <h4 class="mb-0">Department Wise Budget Report</h4>
        <small id="printSubtitle" class="text-muted"></small>
    </div>

    <!-- Filters -->
    <div class="filter-bar no-print">
        <div class="filter-form">
            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <select id="filterYear" class="form-select form-select-sm">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Sector</label>
                <select id="filterSector" class="form-select form-select-sm select2" style="min-width:160px;">
                    <option value="">All Sectors</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Department</label>
                <select id="filterDept" class="form-select form-select-sm select2" style="min-width:220px;">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fund</label>
                <select id="filterFund" class="form-select form-select-sm select2" style="min-width:200px;">
                    <option value="">All Funds</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary btn-sm" onclick="loadData()">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Totals Bar -->
    <div class="totals-banner mb-3 no-print" id="summaryBar" style="display:none!important;">
        <div class="totals-item"><i class="bi bi-cash-stack text-primary me-1"></i><span class="text-muted me-1">Alloc Budget:</span><strong id="sumAllocated">â€”</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-clipboard-check text-info me-1"></i><span class="text-muted me-1">Budget Grant:</span><strong id="sumBudgetGrant">â€”</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-arrow-down-circle text-success me-1"></i><span class="text-muted me-1">Releases:</span><strong id="sumReleases">â€”</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-receipt text-danger me-1"></i><span class="text-muted me-1">Expenditure:</span><strong id="sumExpenditure">â€”</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-piggy-bank text-success me-1"></i><span class="text-muted me-1">Balance:</span><strong id="sumBalance">â€”</strong></div>
    </div>

    <!-- Loading Overlay -->
    <div id="tableLoadingOverlay" style="display:none; text-align:center; padding:40px 0;">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2 text-muted">Loading...</div>
    </div>

    <!-- Cost Center Search Bar (between filters and table) -->
    <div id="ccSearchBar" class="no-print mb-2" style="display:none;">
        <div class="input-group" style="max-width:420px;">
            <span class="input-group-text bg-primary text-white border-0">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" id="ccSearchBox" class="form-control"
                   placeholder="Search Cost Center by name or code..."
                   autocomplete="off" />
            <button class="btn btn-outline-secondary" type="button" onclick="$('#ccSearchBox').val('').trigger('input');" title="Clear search">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <small class="text-muted ms-1">Results update as you type. Expand a Department → Fund first to see Cost Centers.</small>
    </div>

    <!-- Drill-down Tree Table -->
    <div class="table-container" id="tableContainer" style="overflow-x:auto; display:none;">
        <table id="deptTable" class="table table-bordered table-sm print-table drill-table" style="width:100%; min-width:900px;">
            <thead class="table-dark">
                <tr>
                    <th style="width:34px;"></th>
                    <th>Name / Description</th>
                    <th class="text-end">Alloc Budget</th>
                    <th class="text-end">Budget Grant</th>
                    <th class="text-end">Releases</th>
                    <th class="text-end">% Rel</th>
                    <th class="text-end">Expenditure</th>
                    <th class="text-end">% Util</th>
                    <th class="text-end">Balance</th>
                </tr>
            </thead>
            <tbody id="deptTableBody"></tbody>
            <tfoot>
                <tr class="table-secondary fw-bold">
                    <td></td>
                    <td>Total</td>
                    <td class="text-end" id="ftAlloc"></td>
                    <td class="text-end" id="ftGrant"></td>
                    <td class="text-end" id="ftRel"></td>
                    <td class="text-end" id="ftRelPct"></td>
                    <td class="text-end" id="ftExp"></td>
                    <td class="text-end" id="ftUtilPct"></td>
                    <td class="text-end" id="ftBal"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
    /* â”€/* ── Drill-down row styles ──────────────────────────────────────── */

    /* Level 1 — Department */
    .dr-dept { background:#e8edf7 !important; cursor:pointer; }
    .dr-dept:hover { background:#d0dbf0 !important; }
    .dr-dept td:nth-child(2) {
        padding-left:8px !important; font-size:1rem;
        font-weight:700; color:#0d3c8a; letter-spacing:.01em;
    }

    /* Level 2 — Fund */
    .dr-fund { background:#f0f4ff !important; cursor:pointer; }
    .dr-fund:hover { background:#dde6ff !important; }
    .dr-fund td:nth-child(2) {
        padding-left:28px !important; font-size:.95rem;
        font-weight:600; color:#1a4fa0;
    }

    /* Level 3 — Cost Center */
    .dr-cc { background:#f7f9ff !important; cursor:pointer; }
    .dr-cc:hover { background:#eaf0ff !important; }
    .dr-cc td:nth-child(2) {
        padding-left:52px !important; font-size:.9rem;
        font-weight:500; color:#2c5282;
    }

    /* Level 4 — GL Group */
    .dr-grp { background:#eef7ee !important; cursor:pointer; }
    .dr-grp:hover { background:#ddf0dd !important; }
    .dr-grp td:nth-child(2) {
        padding-left:72px !important; font-size:.88rem;
        font-weight:600; color:#155724;
    }

    /* Level 5 — GL Line */
    .dr-gl { background:#fff !important; }
    .dr-gl td:nth-child(2) {
        padding-left:90px !important; font-size:.82rem; color:#444;
    }

    /* Toggle chevron */
    .toggle-btn { cursor:pointer; user-select:none; color:#0d6efd; font-size:.95em; }
    .toggle-btn:hover { color:#0a58ca; }

    /* % badge pills */
    .pct-badge { display:inline-block; padding:1px 8px; border-radius:12px; font-size:.8rem; font-weight:600; }
    .pct-danger-bg  { background:#fde8e8; color:#c0392b; }
    .pct-warning-bg { background:#fff3cd; color:#856404; }
    .pct-ok-bg      { background:#d4edda; color:#155724; }

    /* â”€â”€ Print â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    @@media print {
        .no-print, .page-header, .filter-bar, .sidebar, nav, header, footer { display:none !important; }
        .print-only { display:block !important; }
        body, .main-content, .content-wrapper { margin:0; padding:0; }
        .table-container { overflow:visible !important; }
        #deptTable { font-size:8pt; width:100% !important; }
        .toggle-btn { display:none !important; }
        .print-hide-row { display:none !important; }
    }
    .print-only { display:none; }
    .pct-danger  { color:#dc3545; font-weight:600; }
    .pct-warning { color:#fd7e14; font-weight:600; }
    .pct-ok      { color:#198754; font-weight:600; }
    tfoot td { font-weight:700; background:#f8f9fa; }
</style>
<script>
    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       State
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    let _deptData   = [];   // raw dept rows from server
    let _expanded   = {};   // { key: bool }  - which rows are open

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Boot
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    $(document).ready(function () {
        ajaxGet('/Dashboard/GetFinancialYears', {}, function (r) {
            if (!r.success) return;
            r.data.forEach(i => $('#filterYear').append('<option value="' + i.value + '">' + i.text + '</option>'));
        });

        ['#filterSector', '#filterDept', '#filterFund'].forEach(function (id) {
            $(id).select2({ theme: 'bootstrap-5', allowClear: true, width: '100%' });
        });

        loadSectorDropdown(null);
        loadDeptDropdown(null, null);
        loadFundDropdown(null, null, null);

        $('#filterYear').on('change', function () {
            const y = $(this).val() || null;
            loadSectorDropdown(y);
            loadDeptDropdown(y, null);
            loadFundDropdown(y, null, null);
            loadData();
        });
        $('#filterSector').on('change', function () {
            const y = $('#filterYear').val() || null;
            const s = $(this).val() || null;
            $('#filterDept').val('').trigger('change.select2');
            $('#filterFund').val('').trigger('change.select2');
            loadDeptDropdown(y, s);
            loadFundDropdown(y, null, s);
        });
        $('#filterDept').on('change', function () {
            const y = $('#filterYear').val() || null;
            const s = $('#filterSector').val() || null;
            const d = $(this).val() || null;
            $('#filterFund').val('').trigger('change.select2');
            loadFundDropdown(y, d, s);
        });

        loadData();
    });

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Dropdowns
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function loadSectorDropdown(year) {
        ajaxGet('/Dashboard/GetSectorLookup', year ? { financialYear: year } : {}, function (r) {
            if (!r.success) return;
            rebuildSelect2('#filterSector', r.data, 'All Sectors');
        });
    }
    function loadDeptDropdown(year, sector) {
        const p = {};
        if (year)   p.financialYear = year;
        if (sector) p.sector = sector;
        ajaxGet('/Dashboard/GetDepartmentLookup', p, function (r) {
            if (!r.success) return;
            rebuildSelect2('#filterDept', r.data, 'All Departments');
        });
    }
    function loadFundDropdown(year, departmentCode, sector) {
        const p = {};
        if (year)           p.financialYear = year;
        if (sector)         p.sector = sector;
        if (departmentCode) p.departmentCode = departmentCode;
        ajaxGet('/Dashboard/GetFundLookup', p, function (r) {
            if (!r.success) return;
            rebuildSelect2('#filterFund', r.data, 'All Funds');
        });
    }
    function rebuildSelect2(selector, data, placeholder) {
        const sel = $(selector);
        const cur = sel.val();
        if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
        sel.empty().append('<option value="">' + placeholder + '</option>');
        data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
        sel.select2({ theme: 'bootstrap-5', allowClear: true, width: '100%' });
        if (cur) sel.val(cur).trigger('change');
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Load top-level department data
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function loadData() {
        const year   = $('#filterYear').val()   || null;
        const sector = $('#filterSector').val() || null;
        const dept   = $('#filterDept').val()   || null;
        const fund   = $('#filterFund').val()   || null;

        $('#tableContainer').hide();
        $('#tableLoadingOverlay').show();
        _expanded = {};

        ajaxGet('/Reports/GetDepartmentWiseData',
            { financialYear: year, sector: sector, departmentCode: dept, fundCode: fund },
            function (r) {
                $('#tableLoadingOverlay').hide();
                if (r.success) {
                    _deptData = r.data;
                    renderDeptRows(_deptData);
                    updateSummary(_deptData);
                    updatePrintSubtitle(year, sector, dept, fund);
                    $('#tableContainer').show();
                    $('#ccSearchBar').show();
                } else {
                    showToast('error', r.message || 'Failed to load data.');
                }
            });
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Render department rows (Level 1)
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function renderDeptRows(data) {
        const tbody = $('#deptTableBody');
        tbody.empty();

        let totA=0, totG=0, totR=0, totE=0, totB=0;
        data.forEach(function (row) {
            totA += row.totalAllocatedBudget;
            totG += row.totalBudgetGrant;
            totR += row.totalReleases;
            totE += row.totalActualExpenditure;
            totB += row.totalBalance;

            const rp  = pct(row.totalReleases, row.totalAllocatedBudget);
            const up  = pct(row.totalActualExpenditure, row.totalBudgetGrant);
            const key = 'dept_' + encodeKey(row.departmentName);

            tbody.append(
                '<tr class="dr-dept" data-key="' + key + '" data-dept="' + esc(row.departmentName) + '" onclick="rowToggleDept(this,\'' + encodeKey(row.departmentName) + '\')"><td class="text-center toggle-btn" style="pointer-events:none;"><i class="bi bi-chevron-right"></i></td>' +
                '<td>' + esc(row.departmentName) +
                  ' <button class="btn btn-outline-danger btn-sm py-0 px-1 ms-2 no-print" style="font-size:.75em;" onclick="event.stopPropagation();printDept(\'' + encodeKey(row.departmentName) + '\',event)" title="Download PDF for this department"><i class="bi bi-file-earmark-pdf"></i></button>' +
                '</td>' +
                '<td class="text-end fw-semibold">' + fmtC(row.totalAllocatedBudget) + '</td>' +
                '<td class="text-end fw-semibold">' + fmtC(row.totalBudgetGrant) + '</td>' +
                '<td class="text-end fw-semibold">' + fmtC(row.totalReleases) + '</td>' +
                '<td class="text-end"><span class="pct-badge ' + pctBg(rp) + '">' + rp + '%</span></td>' +
                '<td class="text-end fw-semibold">' + fmtC(row.totalActualExpenditure) + '</td>' +
                '<td class="text-end"><span class="pct-badge ' + pctBg(up) + '">' + up + '%</span></td>' +
                '<td class="text-end fw-semibold">' + fmtC(row.totalBalance) + '</td>' +
                '</tr>'
            );
        });

        const trp = pct(totR, totA), tup = pct(totE, totG);
        $('#ftAlloc').html('<strong>' + fmtC(totA) + '</strong>');
        $('#ftGrant').html('<strong>' + fmtC(totG) + '</strong>');
        $('#ftRel').html('<strong>' + fmtC(totR) + '</strong>');
        $('#ftRelPct').html('<strong class="' + ucls(trp) + '">' + trp + '%</strong>');
        $('#ftExp').html('<strong>' + fmtC(totE) + '</strong>');
        $('#ftUtilPct').html('<strong class="' + ucls(tup) + '">' + tup + '%</strong>');
        $('#ftBal').html('<strong>' + fmtC(totB) + '</strong>');
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Toggle: Level 1 â†’ Level 2 (Funds)
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function toggleDept(cell, deptKey) {
        const deptRow   = $(cell).closest('tr');
        const deptName  = deptRow.data('dept');
        const year      = $('#filterYear').val() || null;
        const childKey  = 'fund_' + deptKey;

        if (_expanded[childKey]) {
            // collapse
            $('[data-parent="' + childKey + '"]').remove();
            _expanded[childKey] = false;
            $(cell).find('i').removeClass('bi-chevron-down').addClass('bi-chevron-right');
            return;
        }

        $(cell).html('<span class="spinner-border spinner-border-sm text-primary"></span>');
        const sector = $('#filterSector').val() || null;
        const params = { departmentName: deptName, financialYear: year };
        if (sector) params.sector = sector;
        ajaxGet('/Reports/GetDrillFunds', params, function (r) {
            $(cell).html('<i class="bi bi-chevron-down"></i>');
            if (!r.success || !r.data.length) { showToast('info', 'No funds found.'); return; }
            _expanded[childKey] = true;

            let html = '';
            r.data.forEach(function (f) {
                const rp = pct(f.totalReleases, f.totalAllocatedBudget);
                const up = pct(f.totalActualExpenditure, f.totalBudgetGrant);
                const fk = 'cc_' + encodeKey(deptKey + '_' + f.fundCode);
                html +=
                    '<tr class="dr-fund" data-parent="' + childKey + '" data-key="' + fk + '" data-fund="' + esc(f.fundCode) + '" data-fundname="' + esc(f.fundDes || f.fundCode) + '" onclick="rowToggleFund(this,\'' + encodeKey(deptKey) + '\',\'' + encodeKey(f.fundCode) + '\',\'' + fk + '\')">' +
                    '<td class="text-center toggle-btn" style="pointer-events:none;"><i class="bi bi-chevron-right"></i></td>' +
                    '<td>' + esc(f.fundDes || f.fundCode) + ' <small class="text-muted">(' + esc(f.fundCode) + ')</small></td>' +
                    '<td class="text-end">' + fmtC(f.totalAllocatedBudget) + '</td>' +
                    '<td class="text-end">' + fmtC(f.totalBudgetGrant) + '</td>' +
                    '<td class="text-end">' + fmtC(f.totalReleases) + '</td>' +
                    '<td class="text-end"><span class="pct-badge ' + pctBg(rp) + '">' + rp + '%</span></td>' +
                    '<td class="text-end">' + fmtC(f.totalActualExpenditure) + '</td>' +
                    '<td class="text-end"><span class="pct-badge ' + pctBg(up) + '">' + up + '%</span></td>' +
                    '<td class="text-end">' + fmtC(f.totalBalance) + '</td>' +
                    '</tr>';
            });
            deptRow.after(html);
        });
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Toggle: Level 2 â†’ Level 3 (Cost Centers)
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function toggleFund(cell, deptKey, fundCode, parentKey) {
        const fundRow  = $(cell).closest('tr');
        const year     = $('#filterYear').val() || null;
        const childKey = 'cc_' + deptKey + '_' + encodeKey(fundCode);

        if (_expanded[childKey]) {
            collapseChildren(childKey);
            _expanded[childKey] = false;
            $(cell).find('i').removeClass('bi-chevron-down').addClass('bi-chevron-right');
            return;
        }

        $(cell).html('<span class="spinner-border spinner-border-sm text-primary"></span>');
        ajaxGet('/Reports/GetCostCenterWiseData', { financialYear: year, fundCode: fundCode }, function (r) {
            $(cell).html('<i class="bi bi-chevron-down"></i>');
            if (!r.success || !r.data.length) { showToast('info', 'No cost centers found.'); return; }
            _expanded[childKey] = true;

            let html = '';
            r.data.forEach(function (cc) {
                const rp = pct(cc.totalReleases, cc.totalAllocatedBudget);
                const up = pct(cc.totalActualExpenditure, cc.totalBudgetGrant);
                const ck = 'gl_' + deptKey + '_' + encodeKey(fundCode) + '_' + encodeKey(cc.fundCenterCode);
                html +=
                    '<tr class="dr-cc" data-parent="' + childKey + '" data-key="' + ck + '" data-cc="' + esc(cc.fundCenterCode) + '" data-ccname="' + esc(cc.costCenterDescription || cc.fundCenterCode) + '" data-fund="' + esc(fundCode) + '" onclick="rowToggleCC(this,\'' + encodeKey(cc.fundCenterCode) + '\',\'' + encodeKey(fundCode) + '\',\'' + ck + '\')">' +
                    '<td class="text-center toggle-btn" style="pointer-events:none;"><i class="bi bi-chevron-right"></i></td>' +
                    '<td>' + esc(cc.costCenterDescription || cc.fundCenterCode) + ' <small class="text-muted">(' + esc(cc.fundCenterCode) + ')</small>' +
                    ' <button class="btn btn-danger btn-sm py-0 px-2 ms-2 no-print" style="font-size:.72em;" onclick="event.stopPropagation();downloadCCPdf(\'' + esc(cc.fundCenterCode) + '\',event)" title="Download PDF for this Cost Center"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</button>' +
                    '</td>' +
                    '<td class="text-end">' + fmtC(cc.totalAllocatedBudget) + '</td>' +
                    '<td class="text-end">' + fmtC(cc.totalBudgetGrant) + '</td>' +
                    '<td class="text-end">' + fmtC(cc.totalReleases) + '</td>' +
                    '<td class="text-end"><span class="pct-badge ' + pctBg(rp) + '">' + rp + '%</span></td>' +
                    '<td class="text-end">' + fmtC(cc.totalActualExpenditure) + '</td>' +
                    '<td class="text-end"><span class="pct-badge ' + pctBg(up) + '">' + up + '%</span></td>' +
                    '<td class="text-end">' + fmtC(cc.totalBalance) + '</td>' +
                    '</tr>';
            });
            // Insert after last sibling with same parent or after fundRow
            const lastSibling = $('[data-parent="' + childKey.replace('cc_','fund_').replace('_' + encodeKey(fundCode),'') + '"]').filter('[data-fund="' + fundCode + '"]');
            fundRow.after(html);
        });
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Toggle: Level 3 â†’ Level 4 (GL Groups: Salary / Non-Salary)
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function toggleCC(cell, ccKey, fundKey, parentKey) {
        const ccRow   = $(cell).closest('tr');
        const ccCode  = ccRow.data('cc');
        const fund    = ccRow.data('fund');
        const year    = $('#filterYear').val() || null;
        const childKey = 'grp_' + ccKey + '_' + fundKey;

        if (_expanded[childKey]) {
            collapseChildren(childKey);
            _expanded[childKey] = false;
            $(cell).find('i').removeClass('bi-chevron-down').addClass('bi-chevron-right');
            return;
        }

        $(cell).html('<span class="spinner-border spinner-border-sm text-primary"></span>');
        ajaxGet('/Reports/GetCostCenterGLDetail', { costCenterCode: ccCode, financialYear: year, fundCode: fund }, function (r) {
            $(cell).html('<i class="bi bi-chevron-down"></i>');
            if (!r.success || !r.data.length) { showToast('info', 'No GL codes found.'); return; }
            _expanded[childKey] = true;

            // Split into Salary (A01*) and Non-Salary
            const salary    = r.data.filter(g => g.glCode && g.glCode.startsWith('A01'));
            const nonSalary = r.data.filter(g => !g.glCode || !g.glCode.startsWith('A01'));

            const sumRow = function(arr) {
                return arr.reduce((s,g) => ({
                    a: s.a + g.totalAllocatedBudget, bg: s.bg + g.totalBudgetGrant,
                    rl: s.rl + g.totalReleases,      ex: s.ex + g.totalActualExpenditure,
                    bl: s.bl + g.totalBalance
                }), { a:0, bg:0, rl:0, ex:0, bl:0 });
            };

            let html = '';

            function addGroup(label, items, grpKey) {
                if (!items.length) return;
                const s  = sumRow(items);
                const rp = pct(s.rl, s.a);
                const up = pct(s.ex, s.bg);
                html +=
                    '<tr class="dr-grp" data-parent="' + childKey + '" data-key="' + grpKey + '">' +
                    '<td class="text-center toggle-btn" onclick="toggleGrp(this,\'' + grpKey + '\')"><i class="bi bi-chevron-right"></i></td>' +
                    '<td><strong>' + label + '</strong> <small class="text-muted">(' + items.length + ' codes)</small></td>' +
                    '<td class="text-end">' + fmtC(s.a) + '</td>' +
                    '<td class="text-end">' + fmtC(s.bg) + '</td>' +
                    '<td class="text-end">' + fmtC(s.rl) + '</td>' +
                    '<td class="text-end ' + ucls(rp) + '">' + rp + '%</td>' +
                    '<td class="text-end text-primary">' + fmtC(s.ex) + '</td>' +
                    '<td class="text-end ' + ucls(up) + '">' + up + '%</td>' +
                    '<td class="text-end">' + fmtC(s.bl) + '</td>' +
                    '</tr>';

                // Store GL rows for lazy render
                _glCache[grpKey] = items;
            }

            addGroup('Salary', salary, 'sal_' + grpKey(ccKey, fundKey));
            addGroup('Non-Salary', nonSalary, 'nsal_' + grpKey(ccKey, fundKey));

            ccRow.after(html);
        });
    }

    function grpKey(ccKey, fundKey) { return ccKey + '_' + fundKey; }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Toggle: Level 4 â†’ Level 5 (Individual GL codes)
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    const _glCache = {};

    function toggleGrp(cell, grpKey) {
        const grpRow   = $(cell).closest('tr');
        const childKey = 'gl_' + grpKey;

        if (_expanded[childKey]) {
            $('[data-parent="' + childKey + '"]').remove();
            _expanded[childKey] = false;
            $(cell).find('i').removeClass('bi-chevron-down').addClass('bi-chevron-right');
            return;
        }

        const items = _glCache[grpKey] || [];
        if (!items.length) return;
        _expanded[childKey] = true;
        $(cell).find('i').removeClass('bi-chevron-right').addClass('bi-chevron-down');

        let html = '';
        items.forEach(function (g) {
            const rp = pct(g.totalReleases, g.totalAllocatedBudget);
            const up = pct(g.totalActualExpenditure, g.totalBudgetGrant);
            html +=
                '<tr class="dr-gl" data-parent="' + childKey + '">' +
                '<td></td>' +
                '<td>' + esc(g.glCode) + (g.glDescription ? ' - ' + esc(g.glDescription) : '') + '</td>' +
                '<td class="text-end">' + fmtC(g.totalAllocatedBudget) + '</td>' +
                '<td class="text-end">' + fmtC(g.totalBudgetGrant) + '</td>' +
                '<td class="text-end">' + fmtC(g.totalReleases) + '</td>' +
                '<td class="text-end ' + ucls(rp) + '">' + rp + '%</td>' +
                '<td class="text-end text-primary">' + fmtC(g.totalActualExpenditure) + '</td>' +
                '<td class="text-end ' + ucls(up) + '">' + up + '%</td>' +
                '<td class="text-end">' + fmtC(g.totalBalance) + '</td>' +
                '</tr>';
        });
        grpRow.after(html);
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Collapse all descendants of a key
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function collapseChildren(parentKey) {
        $('[data-parent="' + parentKey + '"]').each(function () {
            const childKey = $(this).data('key');
            if (childKey) collapseChildren(childKey);
        });
        $('[data-parent="' + parentKey + '"]').remove();
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Summary bar
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function updateSummary(data) {
        if (!data.length) { $('#summaryBar').hide(); return; }
        const a = data.reduce((s, r) => ({
            al: s.al + r.totalAllocatedBudget, bg: s.bg + r.totalBudgetGrant,
            rl: s.rl + r.totalReleases,        ex: s.ex + r.totalActualExpenditure,
            bl: s.bl + r.totalBalance
        }), { al:0, bg:0, rl:0, ex:0, bl:0 });
        $('#sumAllocated').text(fmtC(a.al));
        $('#sumBudgetGrant').text(fmtC(a.bg));
        $('#sumReleases').text(fmtC(a.rl));
        $('#sumExpenditure').text(fmtC(a.ex));
        $('#sumBalance').text(fmtC(a.bl));
        $('#summaryBar').css('display', '');
    }

    function updatePrintSubtitle(year, sector, dept, fund) {
        const parts = [];
        if (year)   parts.push('Year: ' + year);
        if (sector) parts.push('Sector: ' + sector);
        if (dept)   parts.push('Department: ' + dept);
        if (fund)   parts.push('Fund: ' + fund);
        $('#printSubtitle').text(parts.length ? parts.join(' | ') : 'All Years - All Departments');
    }

    function exportExcelReport() {
        const year   = $('#filterYear').val() || '';
        const sector = $('#filterSector').val() || '';
        const dept   = $('#filterDept').val() || '';
        const fund   = $('#filterFund').val() || '';

        const qs = new URLSearchParams();
        if (year) qs.set('financialYear', year);
        if (sector) qs.set('sector', sector);
        if (dept) qs.set('departmentCode', dept);
        if (fund) qs.set('fundCode', fund);

        window.location.href = '/Reports/ExportDepartmentWiseFull?' + qs.toString();
    }

    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       PDF - only visible (expanded) rows
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    function exportPdfReport() {
        const { jsPDF } = window.jspdf;
        const doc    = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
        const pageW  = doc.internal.pageSize.getWidth();
        const pageH  = doc.internal.pageSize.getHeight();
        const cx     = pageW / 2;

        const year   = $('#filterYear').val()   || 'All Years';
        const sector = $('#filterSector').find('option:selected').text() || 'All Sectors';
        const dept   = $('#filterDept').find('option:selected').text()   || 'All Departments';
        const fund   = $('#filterFund').find('option:selected').text()   || 'All Funds';
        const _d     = new Date();
        const _mon   = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const today  = String(_d.getDate()).padStart(2,'0') + ' ' + _mon[_d.getMonth()] + ' ' + _d.getFullYear();

        // ── Header band ────────────────────────────────────────────────────
        doc.setFillColor(11, 43, 82);
        doc.rect(0, 0, pageW, 56, 'F');
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(20);
        doc.setTextColor(255, 255, 255);
        doc.text('DEPARTMENT WISE BUDGET REPORT', cx, 24, { align: 'center' });
        doc.setFontSize(8.5);
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(210, 220, 245);
        doc.text('Year: ' + year + '   |   Sector: ' + sector + '   |   Department: ' + dept + '   |   Fund: ' + fund + '   |   Generated: ' + today, cx, 42, { align: 'center' });

        // ── Collect rows + running grand totals (dept level only) ──────────
        const body   = [];
        const styles = {};
        let idx = 0;
        let totA = 0, totG = 0, totR = 0, totE = 0, totB = 0;

        $('#deptTableBody tr').each(function () {
            const $tr  = $(this);
            const cls  = $tr.attr('class') || '';
            const cells = [];
            $tr.find('td').each(function (ci) {
                if (ci === 0) return;
                cells.push($(this).text().trim());
            });
            if (!cells.length) return;

            if (cls.includes('dr-dept')) {
                totA += parseFloat((cells[1] || '0').replace(/,/g, '')) || 0;
                totG += parseFloat((cells[2] || '0').replace(/,/g, '')) || 0;
                totR += parseFloat((cells[3] || '0').replace(/,/g, '')) || 0;
                totE += parseFloat((cells[5] || '0').replace(/,/g, '')) || 0;
                totB += parseFloat((cells[7] || '0').replace(/,/g, '')) || 0;
            }

            body.push(cells);
            if      (cls.includes('dr-dept')) styles[idx] = { fontStyle:'bold', fillColor:[232,238,252], textColor:[11,43,82] };
            else if (cls.includes('dr-fund')) styles[idx] = { fillColor:[243,246,255], textColor:[20,40,80] };
            else if (cls.includes('dr-cc'))   styles[idx] = { fillColor:[250,252,255], textColor:[30,50,90] };
            else if (cls.includes('dr-grp'))  styles[idx] = { fontStyle:'bold', fillColor:[240,248,240], textColor:[20,70,20] };
            else if (cls.includes('dr-gl'))   styles[idx] = { fillColor:[255,255,255], textColor:[70,70,70], fontSize:7 };
            idx++;
        });

        // ── Grand total row ────────────────────────────────────────────────
        const fmtT  = v => Math.round(v).toLocaleString();
        const totRp = totA > 0 ? (totR / totA * 100).toFixed(1) + '%' : '0.0%';
        const totUp = totG > 0 ? (totE / totG * 100).toFixed(1) + '%' : '0.0%';
        body.push(['GRAND TOTAL', fmtT(totA), fmtT(totG), fmtT(totR), totRp, fmtT(totE), totUp, fmtT(totB)]);
        styles[idx] = { fontStyle:'bold', fillColor:[11,43,82], textColor:[255,255,255] };

        // ── Table ──────────────────────────────────────────────────────────
        doc.autoTable({
            head: [[
                { content: 'NAME / DESCRIPTION', styles: { halign: 'left' } },
                { content: 'ALLOC\nBUDGET',      styles: { halign: 'right' } },
                { content: 'BUDGET\nGRANT',      styles: { halign: 'right' } },
                { content: 'RELEASES',           styles: { halign: 'right' } },
                { content: '% REL',              styles: { halign: 'center' } },
                { content: 'EXPENDITURE',        styles: { halign: 'right' } },
                { content: '% UTIL',             styles: { halign: 'center' } },
                { content: 'BALANCE',            styles: { halign: 'right' } }
            ]],
            body: body,
            startY: 62,
            margin: { left: 8, right: 8, bottom: 24 },
            tableWidth: pageW - 16,
            styles: {
                fontSize: 8,
                cellPadding: { top: 6, bottom: 6, left: 5, right: 5 },
                valign: 'middle',
                lineColor: [220, 225, 235],
                lineWidth: 0.3,
                textColor: [25, 25, 25]
            },
            headStyles: {
                fillColor: [11, 43, 82],
                textColor: [255, 255, 255],
                fontStyle: 'bold',
                fontSize: 8,
                halign: 'center',
                valign: 'middle',
                minCellHeight: 30,
                lineColor: [11, 43, 82],
                lineWidth: 0
            },
            bodyStyles: { halign: 'right' },
            alternateRowStyles: { fillColor: [248, 250, 255] },
            columnStyles: {
                0: { halign: 'left',  cellWidth: 350 },
                1: { halign: 'right', cellWidth: 95 },
                2: { halign: 'right', cellWidth: 95 },
                3: { halign: 'right', cellWidth: 90 },
                4: { halign: 'center', cellWidth: 65 },
                5: { halign: 'right', cellWidth: 95 },
                6: { halign: 'center', cellWidth: 65 },
                7: { halign: 'right', cellWidth: 95 }
            },
            didParseCell: function (d) {
                if (d.section === 'head') return;
                const s = styles[d.row.index];
                if (!s) return;
                if (s.fillColor) d.cell.styles.fillColor = s.fillColor;
                if (s.textColor) d.cell.styles.textColor = s.textColor;
                if (s.fontStyle) d.cell.styles.fontStyle = s.fontStyle;
                if (s.fontSize)  d.cell.styles.fontSize  = s.fontSize;
            },
            didDrawPage: function (data) {
                if (data.pageNumber > 1) {
                    doc.setFillColor(11, 43, 82);
                    doc.rect(0, 0, pageW, 28, 'F');
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(11);
                    doc.setTextColor(255, 255, 255);
                    doc.text('DEPARTMENT WISE BUDGET REPORT  (contd.)', cx, 18, { align: 'center' });
                }
                const pc  = doc.internal.getNumberOfPages();
                const cur = doc.internal.getCurrentPageInfo().pageNumber;
                doc.setFillColor(11, 43, 82);
                doc.rect(0, pageH - 22, pageW, 22, 'F');
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(8);
                doc.setTextColor(245, 248, 252);
                doc.text('Department Wise Budget Report   |   ' + year + '   |   Page ' + cur + ' of ' + pc, cx, pageH - 9, { align: 'center' });
            }
        });

        doc.save('DepartmentWise_' + year.replace(/\//g, '-') + '_' + today.replace(/\s/g, '-') + '.pdf');
    }


    /* Download PDF for a single expanded department */
    function printDept(deptKey, evt) {
        if (evt) evt.stopPropagation();

        var childKey  = 'fund_' + deptKey;
        var deptRow   = $('[data-key="dept_' + deptKey + '"]');
        var deptName  = deptRow.data('dept') || deptKey;

        // Collect all rows belonging to this dept (dept row + all descendants)
        var rows = [];
        rows.push(deptRow[0]);
        function collectChildren(key) {
            $('[data-parent="' + key + '"]').each(function () {
                rows.push(this);
                var ck = $(this).data('key');
                if (ck) collectChildren(ck);
            });
        }
        collectChildren(childKey);

        if (rows.length === 0) {
            showToast('warning', 'Expand the department first to include details in the PDF.');
            return;
        }

        var { jsPDF } = window.jspdf;
        var doc   = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
        var pageW = doc.internal.pageSize.getWidth();
        var pageH = doc.internal.pageSize.getHeight();
        var cx    = pageW / 2;

        var year   = $('#filterYear').val()   || 'All Years';
        var sector = $('#filterSector').val() || 'All Sectors';
        var _d     = new Date();
        var _mon   = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        var today  = String(_d.getDate()).padStart(2,'0') + ' ' + _mon[_d.getMonth()] + ' ' + _d.getFullYear();

        // Title
        doc.setFont('helvetica', 'bold'); doc.setFontSize(16); doc.setTextColor(0, 0, 0);
        doc.text('Department Wise Budget Report', cx, 28, { align: 'center' });
        doc.setDrawColor(13, 71, 161); doc.setLineWidth(1);
        doc.line(20, 34, pageW - 20, 34);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(9);
        doc.text(deptName + '   |   Year: ' + year + '   |   Sector: ' + sector + '   |   Date: ' + today, cx, 46, { align: 'center' });

        // Build body and style map from visible rows
        var body   = [];
        var styles = {};
        var idx    = 0;

        rows.forEach(function (tr) {
            var $tr  = $(tr);
            var cls  = $tr.attr('class') || '';
            var cells = [];
            $tr.find('td').each(function (ci) {
                if (ci === 0) return; // skip toggle chevron cell
                cells.push($(this).text().trim());
            });
            if (!cells.length) return;
            body.push(cells);

            if      (cls.includes('dr-dept')) styles[idx] = { fontStyle:'bold', fillColor:[13,71,161],   textColor:[255,255,255] };
            else if (cls.includes('dr-fund')) styles[idx] = { fillColor:[224,235,255], textColor:[0,0,0] };
            else if (cls.includes('dr-cc'))   styles[idx] = { fillColor:[240,246,255], textColor:[0,0,0] };
            else if (cls.includes('dr-grp'))  styles[idx] = { fontStyle:'bold', fillColor:[224,245,224], textColor:[0,0,0] };
            else if (cls.includes('dr-gl'))   styles[idx] = { fillColor:[255,255,255], textColor:[80,80,80], fontSize:7 };
            idx++;
        });

        doc.autoTable({
            head: [['Name / Description', 'Alloc Budget', 'Budget Grant', 'Releases', '% Rel', 'Expenditure', '% Util', 'Balance']],
            body: body,
            startY: 58,
            tableWidth: 'auto',
            margin: { left: 20, right: 20, bottom: 24 },
            styles: { fontSize: 8, cellPadding: 4, valign: 'middle', lineColor: [200,200,200], lineWidth: 0.3 },
            headStyles: { fillColor: [13,71,161], textColor: [255,255,255], fontStyle: 'bold', halign: 'center' },
            bodyStyles: { halign: 'right' },
            columnStyles: { 0: { halign: 'left', cellWidth: 180 } },
            didParseCell: function (d) {
                if (d.section !== 'body') return;
                var s = styles[d.row.index];
                if (!s) return;
                if (s.fillColor)  d.cell.styles.fillColor  = s.fillColor;
                if (s.textColor)  d.cell.styles.textColor  = s.textColor;
                if (s.fontStyle)  d.cell.styles.fontStyle  = s.fontStyle;
                if (s.fontSize)   d.cell.styles.fontSize   = s.fontSize;
            },
            didDrawPage: function () {
                doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(30, 30, 30);
                var pc  = doc.internal.getNumberOfPages();
                var cur = doc.internal.getCurrentPageInfo().pageNumber;
                doc.text(deptName + '   |   Page ' + cur + ' of ' + pc, cx, pageH - 12, { align: 'center' });
                doc.setDrawColor(13, 71, 161); doc.setLineWidth(0.5);
                doc.line(20, pageH - 20, pageW - 20, pageH - 20);
            }
        });

        var safeName = deptName.replace(/[^a-zA-Z0-9\s]/g, '').trim().replace(/\s+/g, '_');
        doc.save('Dept_' + safeName + '_' + year + '.pdf');
    }
    /* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       Filters clear
    â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
    /* ── In-table CC search handler ───────────────────────────────── */
    $(document).on('input', '#ccSearchBox', function () {
        const term  = $(this).val().trim().toLowerCase();
        const $body = $('#deptTableBody');
        $body.find('tr').show();
        if (!term) return;

        const matchedFundKeys  = new Set();
        const matchedDeptKeys  = new Set();

        $body.find('tr.dr-cc').each(function () {
            const $tr  = $(this);
            const name = ($tr.data('ccname') || '').toLowerCase();
            const code = ($tr.data('cc')     || '').toLowerCase();
            if (name.includes(term) || code.includes(term)) {
                matchedFundKeys.add(String($tr.data('parent') || ''));
            } else {
                $tr.hide();
                const ck = $tr.data('key') || '';
                $body.find('[data-parent^="' + ck + '"]').hide();
            }
        });

        $body.find('tr.dr-fund').each(function () {
            const $tr  = $(this);
            const fKey = String($tr.data('key') || '');
            if (!matchedFundKeys.has(fKey)) {
                $tr.hide();
            } else {
                matchedDeptKeys.add(String($tr.data('parent') || ''));
            }
        });

        $body.find('tr.dr-dept').each(function () {
            const $tr  = $(this);
            const dKey = 'fund_' + encodeKey(String($tr.data('dept') || ''));
            if (!matchedDeptKeys.has(dKey)) $tr.hide();
        });
    });

    /* ── PDF download for a single Cost Center ────────────────────── */
    function downloadCCPdf(ccCode, event) {
        if (event) { event.stopPropagation(); }

        const year    = $('#filterYear').val() || 'All Years';
        const $ccRow  = $('#deptTableBody tr.dr-cc[data-cc="' + ccCode + '"]');
        if (!$ccRow.length) { showToast('error','Cost Center row not found in table.'); return; }

        const ccName  = $ccRow.data('ccname') || ccCode;
        const ccKey   = $ccRow.data('key')    || '';
        const fund    = $ccRow.data('fund')   || '';

        // Fetch GL detail fresh via AJAX so PDF always has latest data
        ajaxGet('/Reports/GetCostCenterGLDetail', { costCenterCode: ccCode, financialYear: $('#filterYear').val() || null, fundCode: fund }, function (r) {
            const { jsPDF } = window.jspdf;
            const doc    = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
            const pageW  = doc.internal.pageSize.getWidth();
            const pageH  = doc.internal.pageSize.getHeight();
            const cx     = pageW / 2;
            const today  = new Date().toLocaleDateString('en-PK', { day:'2-digit', month:'short', year:'numeric' });

            // ── Header block ──
            doc.setFillColor(13, 71, 161);
            doc.rect(0, 0, pageW, 38, 'F');
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(14);
            doc.setTextColor(255, 255, 255);
            doc.text('Cost Center Budget Report', cx, 16, { align: 'center' });
            doc.setFontSize(9);
            doc.text(ccName + '  (' + ccCode + ')', cx, 29, { align: 'center' });

            doc.setDrawColor(13, 71, 161); doc.setLineWidth(0.5);
            doc.line(20, 46, pageW - 20, 46);
            doc.setFont('helvetica', 'normal'); doc.setFontSize(8); doc.setTextColor(40, 40, 40);
            doc.text('Year: ' + year + '   |   Fund: ' + fund + '   |   Generated: ' + today, cx, 56, { align: 'center' });

            // ── CC summary row ──
            const cc = {
                a: parseFloat($ccRow.find('td').eq(2).text().replace(/,/g,'')) || 0,
                g: parseFloat($ccRow.find('td').eq(3).text().replace(/,/g,'')) || 0,
                rl: parseFloat($ccRow.find('td').eq(4).text().replace(/,/g,'')) || 0,
                ex: parseFloat($ccRow.find('td').eq(6).text().replace(/,/g,'')) || 0,
                bl: parseFloat($ccRow.find('td').eq(8).text().replace(/,/g,'')) || 0
            };
            const rp = cc.a > 0 ? (cc.rl/cc.a*100).toFixed(1)+'%' : '0.0%';
            const up = cc.g > 0 ? (cc.ex/cc.g*100).toFixed(1)+'%' : '0.0%';

            const headers = [['GL Code','GL Description','Alloc Budget','Budget Grant','Releases','% Rel','Expenditure','% Util','Balance']];
            const body    = [];
            const styles  = {};
            let idx = 0;

            // Summary row for the CC itself
            body.push([ccName + ' (' + ccCode + ')',
                '', fmtN(cc.a), fmtN(cc.g), fmtN(cc.rl), rp, fmtN(cc.ex), up, fmtN(cc.bl)]);
            styles[idx++] = { fillColor:[13,71,161], textColor:[255,255,255], fontStyle:'bold' };

            if (r.success && r.data.length) {
                // Group: Salary
                const salary    = r.data.filter(g => g.glCode && g.glCode.startsWith('A01'));
                const nonSalary = r.data.filter(g => !g.glCode || !g.glCode.startsWith('A01'));

                function addGroup(label, items) {
                    if (!items.length) return;
                    const s = items.reduce((acc, g) => ({
                        a:  acc.a  + g.totalAllocatedBudget,
                        g:  acc.g  + g.totalBudgetGrant,
                        rl: acc.rl + g.totalReleases,
                        ex: acc.ex + g.totalActualExpenditure,
                        bl: acc.bl + g.totalBalance
                    }), { a:0, g:0, rl:0, ex:0, bl:0 });
                    const rp = s.a > 0 ? (s.rl/s.a*100).toFixed(1)+'%' : '0.0%';
                    const up = s.g > 0 ? (s.ex/s.g*100).toFixed(1)+'%' : '0.0%';
                    body.push([label, '', fmtN(s.a), fmtN(s.g), fmtN(s.rl), rp, fmtN(s.ex), up, fmtN(s.bl)]);
                    styles[idx++] = { fillColor:[21,101,51], textColor:[255,255,255], fontStyle:'bold' };
                    items.forEach(function (g) {
                        const grp = g.totalAllocatedBudget, gbg = g.totalBudgetGrant;
                        const grp2 = g.totalReleases, gex = g.totalActualExpenditure, gbl = g.totalBalance;
                        const grp_r = grp > 0 ? (grp2/grp*100).toFixed(1)+'%' : '0.0%';
                        const gup   = gbg > 0 ? (gex/gbg*100).toFixed(1)+'%'  : '0.0%';
                        body.push([g.glCode || '', g.glDescription || '', fmtN(grp), fmtN(gbg), fmtN(grp2), grp_r, fmtN(gex), gup, fmtN(gbl)]);
                        styles[idx++] = { fillColor:[245,250,245], textColor:[30,30,30] };
                    });
                }
                addGroup('Salary', salary);
                addGroup('Non-Salary', nonSalary);
            }

            doc.autoTable({
                head: headers,
                body: body,
                startY: 68,
                margin: { left: 20, right: 20, bottom: 26 },
                styles: { fontSize: 8, cellPadding: 4, valign: 'middle', lineColor:[200,200,200], lineWidth:0.3 },
                headStyles: { fillColor:[13,71,161], textColor:[255,255,255], fontStyle:'bold', halign:'center' },
                bodyStyles: { halign:'right' },
                columnStyles: {
                    0: { halign:'left', cellWidth:55 },
                    1: { halign:'left', cellWidth:160 }
                },
                didParseCell: function (d) {
                    if (d.section !== 'body') return;
                    const s = styles[d.row.index];
                    if (!s) return;
                    if (s.fillColor) d.cell.styles.fillColor = s.fillColor;
                    if (s.textColor) d.cell.styles.textColor = s.textColor;
                    if (s.fontStyle) d.cell.styles.fontStyle = s.fontStyle;
                },
                didDrawPage: function () {
                    const pc  = doc.internal.getNumberOfPages();
                    const cur = doc.internal.getCurrentPageInfo().pageNumber;
                    doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(80,80,80);
                    doc.text(ccName + '  |  Page ' + cur + ' of ' + pc, cx, pageH - 12, { align:'center' });
                    doc.setDrawColor(13,71,161); doc.setLineWidth(0.4);
                    doc.line(20, pageH - 20, pageW - 20, pageH - 20);
                }
            });

            const safe = (ccName + '_' + ccCode).replace(/[^a-zA-Z0-9_]/g,'_');
            doc.save('CC_' + safe + '_' + year.replace(/\//g,'-') + '.pdf');
        });
    }

    function fmtN(v) { return Math.round(v || 0).toLocaleString(); }

    function clearFilters() {
        $('#filterYear').val('');
        $('#ccSearchBox').val('');
        $('#deptTableBody tr').show();
        ['#filterSector','#filterDept','#filterFund'].forEach(id => $(id).val('').trigger('change.select2'));
        loadSectorDropdown(null);
        loadDeptDropdown(null, null);
        loadFundDropdown(null, null, null);
        loadData();
    }
function fmtC(v)  { return Math.round(v || 0).toLocaleString(); }
function fmtN(v)  { return Math.round(v || 0).toLocaleString(); }
function esc(s)   { return $('<span>').text(String(s||'')).html(); }
function pct(n,d) { return d > 0 ? (n/d*100).toFixed(1) : '0.0'; }
function ucls(p)  { const n=parseFloat(p); return n>=90?'pct-danger':n>=70?'pct-warning':'pct-ok'; }
function pctBg(p) { const n=parseFloat(p); return n>=90?'pct-danger-bg':n>=70?'pct-warning-bg':'pct-ok-bg'; }
function encodeKey(s) { return String(s||'').replace(/[^a-zA-Z0-9]/g,'_'); }

/* Row-level click wrappers — clicking anywhere on the row triggers expand/collapse */
function rowToggleDept(tr, deptKey) {
    const cell = tr.querySelector('.toggle-btn');
    if (cell) toggleDept(cell, deptKey);
}
function rowToggleFund(tr, deptKey, fundCode, parentKey) {
    const cell = tr.querySelector('.toggle-btn');
    if (cell) toggleFund(cell, deptKey, fundCode, parentKey);
}
function rowToggleCC(tr, ccKey, fundKey, parentKey) {
    const cell = tr.querySelector('.toggle-btn');
    if (cell) toggleCC(cell, ccKey, fundKey, parentKey);
}
