    function loadGLDetail(ccCode, dtRow, ico) {
        const year    = $('#filterYear').val() || null;
        const fund    = $('#filterFund').val() || null;
        const objVals = $('#filterObj').val()  || [];

        ico.removeClass('bi-plus-circle text-primary').addClass('bi-arrow-repeat text-secondary');

        // Build URL with repeated objectCodes= params
        let url = '/Reports/GetCostCenterGLDetail?costCenterCode=' + encodeURIComponent(ccCode);
        if (year) url += '&financialYear=' + encodeURIComponent(year);
        if (fund) url += '&fundCode='      + encodeURIComponent(fund);
        objVals.forEach(function (v) { url += '&objectCodes=' + encodeURIComponent(v); });

        ajaxGet(url, {},
            function (r) {
                if (!r.success) { showToast('error', r.message || 'Failed to load GL detail.'); return; }
                const rows = r.data;

                // Object filter label for the GL panel header
                const objLabel = objVals.length > 0
                    ? ' &nbsp;<span class="badge bg-info text-dark">Filtered: ' + objVals.map(v => esc($('#filterObj option[value="' + v + '"]').text() || v)).join(', ') + '</span>'
                    : '';

                let html = '<div class="p-2" style="background:#f0f4ff;">';
                html += '<div class="d-flex justify-content-between align-items-center mb-2">';
                html += '<strong class="text-primary"><i class="bi bi-list-ul me-1"></i>GL Detail — ' + esc(ccCode) + objLabel + '</strong>';
                html += '<button class="btn btn-danger btn-xs py-0 px-2" style="font-size:11px;" onclick="exportGLPdf(\'' + ccCode + '\', \''+ ccCode +'\')">';
                html += '<i class="bi bi-file-earmark-pdf"></i> Download PDF</button></div>';
                html += '<div style="overflow-x:auto;"><table class="table table-bordered table-sm table-hover mb-0" style="font-size:12px;width:100%;">';
                html += '<thead class="table-primary"><tr>';
                html += '<th>GL Code</th><th>GL Description</th>';
                html += '<th class="text-end">Alloc Budget</th><th class="text-end">Budget Grant</th>';
                html += '<th class="text-end">Releases</th><th class="text-end">% Release</th>';
                html += '<th class="text-end">Supplementary</th><th class="text-end">Reapp (+)</th>';
                html += '<th class="text-end">Reapp (-)</th><th class="text-end">Surrender</th>';
                html += '<th class="text-end">Final Budget</th>';
                html += '<th class="text-end">Expenditure</th><th class="text-end">% Util</th>';
                html += '<th class="text-end">Balance</th>';
                html += '</tr></thead><tbody>';
                let tAl = 0, tBg = 0, tRl = 0, tEx = 0, tBl = 0;
                let tSupp = 0, tReappPlus = 0, tReappMinus = 0, tSurr = 0, tFinalGrant = 0;
                rows.forEach(function (g) {
                    const rPct = parseFloat(g.releasePercentage).toFixed(1);
                    const uPct = parseFloat(g.utilizationPercentage).toFixed(1);
                    tAl += g.totalAllocatedBudget; tBg += g.totalBudgetGrant;
                    tRl += g.totalReleases;         tEx += g.totalActualExpenditure; tBl += g.totalBalance;
                    tSupp += g.totalSupplementaryGrant; tReappPlus += g.totalReappropriationPlus;
                    tReappMinus += g.totalReappropriationMinus; tSurr += g.totalSurrender; tFinalGrant += g.totalFinalGrant;
                    html += '<tr>';
                    html += '<td><code>' + esc(g.glCode) + '</code></td>';
                    html += '<td>' + esc(g.glDescription || '—') + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalAllocatedBudget)  + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalBudgetGrant)      + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalReleases)         + '</td>';
                    html += '<td class="text-end ' + utilClass(rPct) + '">' + rPct + '%</td>';
                    html += '<td class="text-end">' + fmtC(g.totalSupplementaryGrant)   + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalReappropriationPlus)  + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalReappropriationMinus) + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalSurrender)            + '</td>';
                    html += '<td class="text-end fw-semibold">' + fmtC(g.totalFinalGrant) + '</td>';
                    html += '<td class="text-end text-primary">' + fmtC(g.totalActualExpenditure) + '</td>';
                    html += '<td class="text-end ' + utilClass(uPct) + '">' + uPct + '%</td>';
                    html += '<td class="text-end">' + fmtC(g.totalBalance) + '</td>';
                    html += '</tr>';
                });
                const totRPct = tAl > 0 ? (tRl / tAl * 100).toFixed(1) : '0.0';
                const totUPct = tBg > 0 ? (tEx / tBg * 100).toFixed(1) : '0.0';
                html += '<tr class="table-secondary fw-bold">';
                html += '<td colspan="2">Total</td>';
                html += '<td class="text-end">' + fmtC(tAl) + '</td><td class="text-end">' + fmtC(tBg) + '</td>';
                html += '<td class="text-end">' + fmtC(tRl) + '</td><td class="text-end">' + totRPct + '%</td>';
                html += '<td class="text-end">' + fmtC(tSupp) + '</td><td class="text-end">' + fmtC(tReappPlus) + '</td>';
                html += '<td class="text-end">' + fmtC(tReappMinus) + '</td><td class="text-end">' + fmtC(tSurr) + '</td>';
                html += '<td class="text-end">' + fmtC(tFinalGrant) + '</td>';
                html += '<td class="text-end">' + fmtC(tEx) + '</td><td class="text-end">' + totUPct + '%</td>';
                html += '<td class="text-end">' + fmtC(tBl) + '</td></tr>';
                html += '</tbody></table></div></div>';

                dtRow.data() && (dtRow.node()._glData = { rows: rows, ccCode: ccCode });
                dtRow.child(html).show();
                ico.removeClass('bi-arrow-repeat text-secondary').addClass('bi-dash-circle text-danger');
            });
    }

    function exportGLPdf(ccCode, ccDesc) {
        const year      = $('#filterYear').val() || 'All Years';
        const fundLabel = $('#filterFund').find('option:selected').text() || 'All Funds';
        const objVals   = $('#filterObj').val() || [];
        const objLabel  = objVals.length > 0
            ? objVals.map(v => $('#filterObj option[value="' + v + '"]').text() || v).join(', ')
            : 'All Objects';
        const _d   = new Date();
        const _mon = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const today = String(_d.getDate()).padStart(2,'0') + ' ' + _mon[_d.getMonth()] + ' ' + _d.getFullYear();

        // Build URL with object filter
        let url = '/Reports/GetCostCenterGLDetail?costCenterCode=' + encodeURIComponent(ccCode);
        const yr = $('#filterYear').val() || null;
        const fn = $('#filterFund').val() || null;
        if (yr) url += '&financialYear=' + encodeURIComponent(yr);
        if (fn) url += '&fundCode='      + encodeURIComponent(fn);
        objVals.forEach(function (v) { url += '&objectCodes=' + encodeURIComponent(v); });

        ajaxGet(url, {},
            function (r) {
                if (!r.success) { showToast('error', 'Failed to load GL data for PDF.'); return; }

                const { jsPDF } = window.jspdf;
                const doc   = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
                const pageW = doc.internal.pageSize.getWidth();
                const pageH = doc.internal.pageSize.getHeight();
                const cx    = pageW / 2;

                // ── Header band ─────────────────────────────────────────────────────
                // Taller header when object filter is shown
                const hdrH = objVals.length > 0 ? 80 : 68;
                doc.setFillColor(11, 43, 82);
                doc.rect(0, 0, pageW, hdrH, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(18);
                doc.setTextColor(255, 255, 255);
                doc.text('GL DETAIL REPORT — COST CENTER', cx, 20, { align: 'center' });
                doc.setFontSize(10);
                const nameLabel = (ccDesc && ccDesc !== ccCode) ? ccCode + '  –  ' + ccDesc : ccCode;
                doc.text(nameLabel, cx, 35, { align: 'center' });
                doc.setFontSize(8.5);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(210, 220, 245);
                doc.text('Year: ' + year + '   |   Grant: ' + fundLabel + '   |   Generated: ' + today, cx, 50, { align: 'center' });
                if (objVals.length > 0) {
                    doc.text('Object Filter: ' + objLabel, cx, 64, { align: 'center' });
                }

                // ── Build body + styles ───────────────────────────────────────────────
                const salary    = r.data.filter(g => g.glCode && g.glCode.startsWith('A01'));
                const nonSalary = r.data.filter(g => !g.glCode || !g.glCode.startsWith('A01'));

                const body   = [];
                const styles = {};
                let idx = 0;
                let tAl=0, tBg=0, tRl=0, tEx=0, tBl=0;
                let tSupp=0, tReappPlus=0, tReappMinus=0, tSurr=0, tFinalGrant=0;

                function addGroup(label, items) {
                    if (!items.length) return;
                    const s = items.reduce((acc, g) => ({
                        a:  acc.a  + g.totalAllocatedBudget,
                        bg: acc.bg + g.totalBudgetGrant,
                        rl: acc.rl + g.totalReleases,
                        supp: acc.supp + g.totalSupplementaryGrant,
                        rp:  acc.rp  + g.totalReappropriationPlus,
                        rm:  acc.rm  + g.totalReappropriationMinus,
                        sur: acc.sur + g.totalSurrender,
                        fg:  acc.fg  + g.totalFinalGrant,
                        ex: acc.ex + g.totalActualExpenditure,
                        bl: acc.bl + g.totalBalance
                    }), { a:0, bg:0, rl:0, supp:0, rp:0, rm:0, sur:0, fg:0, ex:0, bl:0 });
                    const rpPct = s.a  > 0 ? (s.rl / s.a  * 100).toFixed(1) + '%' : '0.0%';
                    const upPct = s.bg > 0 ? (s.ex / s.bg * 100).toFixed(1) + '%' : '0.0%';
                    body.push([label, '', fmtC(s.a), fmtC(s.bg), fmtC(s.rl), rpPct, fmtC(s.supp), fmtC(s.rp), fmtC(s.rm), fmtC(s.sur), fmtC(s.fg), fmtC(s.ex), upPct, fmtC(s.bl)]);
                    styles[idx++] = { fontStyle:'bold', fillColor:[224,245,224], textColor:[20,70,20] };

                    items.forEach(function (g) {
                        const grp = g.totalAllocatedBudget, gbg = g.totalBudgetGrant;
                        const grl = g.totalReleases, gex = g.totalActualExpenditure, gbl = g.totalBalance;
                        const gsupp = g.totalSupplementaryGrant, grAdd = g.totalReappropriationPlus;
                        const grSub = g.totalReappropriationMinus, gsur = g.totalSurrender, gfg = g.totalFinalGrant;
                        const grp_r = grp > 0 ? (grl / grp * 100).toFixed(1) + '%' : '0.0%';
                        const gup   = gbg > 0 ? (gex / gbg * 100).toFixed(1) + '%' : '0.0%';
                        body.push([g.glCode || '', g.glDescription || '', fmtC(grp), fmtC(gbg), fmtC(grl), grp_r, fmtC(gsupp), fmtC(grAdd), fmtC(grSub), fmtC(gsur), fmtC(gfg), fmtC(gex), gup, fmtC(gbl)]);
                        styles[idx++] = { fillColor:[255,255,255], textColor:[60,60,60], fontSize:7 };
                        tAl+=grp; tBg+=gbg; tRl+=grl; tEx+=gex; tBl+=gbl;
                        tSupp+=gsupp; tReappPlus+=grAdd; tReappMinus+=grSub; tSurr+=gsur; tFinalGrant+=gfg;
                    });
                }

                addGroup('Salary',     salary);
                addGroup('Non-Salary', nonSalary);

                const totRp = tAl > 0 ? (tRl/tAl*100).toFixed(1)+'%' : '0.0%';
                const totUp = tBg > 0 ? (tEx/tBg*100).toFixed(1)+'%' : '0.0%';
                body.push(['GRAND TOTAL', '', fmtC(tAl), fmtC(tBg), fmtC(tRl), totRp, fmtC(tSupp), fmtC(tReappPlus), fmtC(tReappMinus), fmtC(tSurr), fmtC(tFinalGrant), fmtC(tEx), totUp, fmtC(tBl)]);
                styles[idx] = { fontStyle:'bold', fillColor:[11,43,82], textColor:[255,255,255] };

                // ── Table ──────────────────────────────────────────────────────
                const glColWeights = [65, 170, 80, 80, 75, 45, 75, 75, 75, 75, 80, 80, 45, 80];
                const glWeightSum  = glColWeights.reduce((a, b) => a + b, 0);
                const glTableWidth = pageW - 16;
                const glColWidths  = glColWeights.map(w => (w / glWeightSum) * glTableWidth);

                doc.autoTable({
                    head: [[
                        { content: 'GL CODE',      styles: { halign: 'left'   } },
                        { content: 'GL DESCRIPTION', styles: { halign: 'left'   } },
                        { content: 'ALLOC\nBUDGET', styles: { halign: 'right'  } },
                        { content: 'BUDGET\nGRANT', styles: { halign: 'right'  } },
                        { content: 'RELEASES',      styles: { halign: 'right'  } },
                        { content: '% REL',         styles: { halign: 'center' } },
                        { content: 'SUPPLEMENTARY', styles: { halign: 'right'  } },
                        { content: 'REAPP (+)',     styles: { halign: 'right'  } },
                        { content: 'REAPP (-)',     styles: { halign: 'right'  } },
                        { content: 'SURRENDER',     styles: { halign: 'right'  } },
                        { content: 'FINAL\nBUDGET', styles: { halign: 'right'  } },
                        { content: 'EXPENDITURE',   styles: { halign: 'right'  } },
                        { content: '% UTIL',        styles: { halign: 'center' } },
                        { content: 'BALANCE',       styles: { halign: 'right'  } }
                    ]],
                    body: body,
                    startY: hdrH + 6,
                    margin: { left: 8, right: 8, bottom: 24 },
                    tableWidth: glTableWidth,
                    horizontalPageBreak: false,
                    styles: {
                        fontSize: 8,
                        cellPadding: { top: 6, bottom: 6, left: 5, right: 5 },
                        valign: 'middle',
                        lineColor: [220, 225, 235],
                        lineWidth: 0.3,
                        textColor: [25, 25, 25],
                        overflow: 'linebreak'
                    },
                    headStyles: {
                        fillColor: [11, 43, 82],
                        textColor: [255, 255, 255],
                        fontStyle: 'bold',
                        fontSize: 8,
                        halign: 'center',
                        valign: 'middle',
                        minCellHeight: 30,
                        lineColor: [11, 43, 82],
                        lineWidth: 0
                    },
                    bodyStyles: { halign: 'right' },
                    alternateRowStyles: { fillColor: [248, 250, 255] },
                    columnStyles: {
                        0: { halign: 'left',   cellWidth: glColWidths[0]  },
                        1: { halign: 'left',   cellWidth: glColWidths[1]  },
                        2: { halign: 'right',  cellWidth: glColWidths[2]  },
                        3: { halign: 'right',  cellWidth: glColWidths[3]  },
                        4: { halign: 'right',  cellWidth: glColWidths[4]  },
                        5: { halign: 'center', cellWidth: glColWidths[5]  },
                        6: { halign: 'right',  cellWidth: glColWidths[6]  },
                        7: { halign: 'right',  cellWidth: glColWidths[7]  },
                        8: { halign: 'right',  cellWidth: glColWidths[8]  },
                        9: { halign: 'right',  cellWidth: glColWidths[9]  },
                        10: { halign: 'right',  cellWidth: glColWidths[10] },
                        11: { halign: 'right',  cellWidth: glColWidths[11] },
                        12: { halign: 'center', cellWidth: glColWidths[12] },
                        13: { halign: 'right',  cellWidth: glColWidths[13] }
                    },
                    didParseCell: function (d) {
                        if (d.section === 'head') return;
                        const s = styles[d.row.index];
                        if (!s) return;
                        if (s.fillColor) d.cell.styles.fillColor = s.fillColor;
                        if (s.textColor) d.cell.styles.textColor = s.textColor;
                        if (s.fontStyle) d.cell.styles.fontStyle = s.fontStyle;
                        if (s.fontSize)  d.cell.styles.fontSize  = s.fontSize;
                    },
                    didDrawPage: function (data) {
                        if (data.pageNumber > 1) {
                            doc.setFillColor(11, 43, 82);
                            doc.rect(0, 0, pageW, 28, 'F');
                            doc.setFont('helvetica', 'bold');
                            doc.setFontSize(11);
                            doc.setTextColor(255, 255, 255);
                            doc.text('GL DETAIL REPORT  (contd.)  —  ' + ccCode, cx, 18, { align: 'center' });
                        }
                        const pc  = doc.internal.getNumberOfPages();
                        const cur = doc.internal.getCurrentPageInfo().pageNumber;
                        doc.setFillColor(11, 43, 82);
                        doc.rect(0, pageH - 22, pageW, 22, 'F');
                        doc.setFont('helvetica', 'normal');
                        doc.setFontSize(8);
                        doc.setTextColor(245, 248, 252);
                        doc.text('GL Detail — ' + ccCode + '   |   Year: ' + year + '   |   Grant: ' + fundLabel + '   |   Page ' + cur + ' of ' + pc, cx, pageH - 9, { align: 'center' });
                    }
                });

                doc.save('GLDetail_' + ccCode + '_' + year.replace(/\//g, '-') + '_' + today.replace(/\s/g, '-') + '.pdf');
            });
    }

    function clearFilters() {
