@{
    ViewData["Title"] = "Cost Center Wise Report";
}

<div class="fade-in" id="reportWrapper">

    <!-- Page Header -->
    <div class="page-header no-print">
        <div>
            <h2 class="page-title"><i class="bi bi-building me-2"></i>Cost Center Wise Report</h2>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-success btn-sm" onclick="exportExcel()">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportPdfReport()">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </button>
            <button class="btn btn-outline-info btn-sm" onclick="printFiltered()">
                <i class="bi bi-printer me-1"></i>Print Selected
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print All
            </button>
        </div>
    </div>

    <!-- Print Header -->
    <div class="print-only mb-3">
        <h4 class="mb-0">Cost Center Wise Budget Report</h4>
        <small id="printSubtitle" class="text-muted"></small>
    </div>

    <!-- Filters -->
    <div class="filter-bar no-print">
        <div class="filter-form">
            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <select id="filterYear" class="form-select form-select-sm">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fund</label>
                <select id="filterFund" class="form-select form-select-sm select2" style="min-width:220px;">
                    <option value="">All Funds</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Cost Center</label>
                <select id="filterCC" class="form-select form-select-sm select2" style="min-width:240px;">
                    <option value="">All Cost Centers</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary btn-sm" onclick="loadData()">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Totals Bar -->
    <div class="totals-banner mb-3 no-print" id="summaryBar" style="display:none!important;">
        <div class="totals-item"><i class="bi bi-cash-stack text-primary me-1"></i><span class="text-muted me-1">Alloc Budget:</span><strong id="sumAllocated">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-clipboard-check text-info me-1"></i><span class="text-muted me-1">Budget Grant:</span><strong id="sumBudgetGrant">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-arrow-down-circle text-success me-1"></i><span class="text-muted me-1">Releases:</span><strong id="sumReleases">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-receipt text-danger me-1"></i><span class="text-muted me-1">Expenditure:</span><strong id="sumExpenditure">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-piggy-bank text-success me-1"></i><span class="text-muted me-1">Balance:</span><strong id="sumBalance">—</strong></div>
    </div>

    <!-- Data Table -->
    <div class="table-container" style="overflow-x:auto; position:relative;">
        <div id="tableLoadingOverlay" style="display:none; position:absolute; inset:0; background:rgba(255,255,255,0.8); z-index:10; align-items:center; justify-content:center; border-radius:6px;">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-primary fw-semibold">Loading data...</div>
            </div>
        </div>
        <table id="ccTable" class="table table-bordered table-sm table-hover print-table" style="width:100%; min-width:950px;">
            <thead class="table-dark">
                <tr>
                    <th style="width:30px;"></th>
                    <th>Cost Center Description</th>
                    <th class="text-end">Allocated Budget</th>
                    <th class="text-end">Budget Grant</th>
                    <th class="text-end">Releases</th>
                    <th class="text-end">% Release</th>
                    <th class="text-end">Total Expenditure</th>
                    <th class="text-end">% Utilization</th>
                    <th class="text-end">Balance</th>
                    <th class="text-center no-print">Detail PDF</th>
                </tr>
            </thead>
            <tbody id="ccTableBody"></tbody>
            <tfoot id="ccTableFoot"></tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
    @@media print {
        .no-print, .page-header, .filter-bar, .sidebar, nav, header, footer { display: none !important; }
        .print-only { display: block !important; }
        body, .main-content, .content-wrapper { margin: 0; padding: 0; }
        .table-container { overflow: visible !important; }
        #ccTable { font-size: 9pt; width: 100% !important; }
        #ccTable thead { background: #343a40 !important; color: #fff !important; -webkit-print-color-adjust: exact; }
        #ccTable tfoot td { font-weight: bold; background: #f8f9fa; -webkit-print-color-adjust: exact; }
        .dataTables_paginate, .dataTables_filter, .dataTables_info, .dataTables_length { display: none !important; }
        table.dataTable tbody tr { display: table-row !important; }
    }
    .print-only { display: none; }
    .pct-danger  { color: #dc3545; font-weight: 600; }
    .pct-warning { color: #fd7e14; font-weight: 600; }
    .pct-ok      { color: #198754; font-weight: 600; }
    tfoot td     { font-weight: 700; background: #f8f9fa; }
    td.dt-control { cursor: pointer; }
    tr.shown td.dt-control i { color: #dc3545; }
    .btn-xs { font-size: 11px !important; padding: 1px 5px !important; }
</style>
<script>
    let ccDT = null;

    $(document).ready(function () {
        ajaxGet('/Dashboard/GetFinancialYears', {}, function (r) {
            if (!r.success) return;
            const sel = $('#filterYear');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
        });

        $('#filterFund').select2({ theme: 'bootstrap-5', placeholder: 'All Funds',        allowClear: true, width: '100%' });
        $('#filterCC').select2(  { theme: 'bootstrap-5', placeholder: 'All Cost Centers', allowClear: true, width: '100%' });

        loadFundDropdown(null);
        loadCCDropdown(null, null);

        $('#filterYear').on('change', function () {
            const yr = $(this).val() || null;
            loadFundDropdown(yr);
            loadCCDropdown(yr, null);
            loadData();
        });

        $('#filterFund').on('change', function () {
            const yr = $('#filterYear').val() || null;
            const fc = $(this).val() || null;
            loadCCDropdown(yr, fc);
            loadData();
        });

        loadData();
    });

    function loadFundDropdown(year) {
        const params = year ? { financialYear: year } : {};
        ajaxGet('/Dashboard/GetFundLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterFund');
            const cur = sel.val();
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Funds</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Funds', allowClear: true, width: '100%' });
            if (cur) sel.val(cur).trigger('change');
        });
    }

    function loadCCDropdown(year, fundCode) {
        const params = {};
        if (year)     params.financialYear = year;
        if (fundCode) params.fundCode      = fundCode;
        ajaxGet('/Dashboard/GetCostCenterLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterCC');
            const cur = sel.val();
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Cost Centers</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Cost Centers', allowClear: true, width: '100%' });
            if (cur) sel.val(cur).trigger('change');
        });
    }

    function loadData() {
        const year = $('#filterYear').val() || null;
        const fund = $('#filterFund').val() || null;
        const cc   = $('#filterCC').val()   || null;

        $('#tableLoadingOverlay').css('display', 'flex');

        ajaxGet('/Reports/GetCostCenterWiseData',
            { financialYear: year, fundCode: fund, costCenterCode: cc },
            function (r) {
                $('#tableLoadingOverlay').hide();
                if (r.success) {
                    renderTable(r.data);
                    updateSummary(r.data);
                    updatePrintSubtitle(year, fund, cc);
                } else {
                    showToast('error', r.message || 'Failed to load data.');
                }
            },
            function () {
                $('#tableLoadingOverlay').hide();
                showToast('error', 'Failed to load data.');
            });
    }

    function renderTable(data) {
        if (ccDT) { ccDT.destroy(); ccDT = null; }

        const tbody = $('#ccTableBody');
        const tfoot = $('#ccTableFoot');
        tbody.empty();
        tfoot.empty();

        let totAllocated = 0, totGrant = 0, totReleases = 0, totExp = 0, totBalance = 0;
        window._ccPdfRows = [];

        data.forEach(function (row) {
            const relPct  = parseFloat(row.releasePercentage).toFixed(1);
            const utilPct = parseFloat(row.utilizationPercentage).toFixed(1);
            const relCls  = utilClass(relPct);
            const utilCls = utilClass(utilPct);

            totAllocated += row.totalAllocatedBudget;
            totGrant     += row.totalBudgetGrant;
            totReleases  += row.totalReleases;
            totExp       += row.totalActualExpenditure;
            totBalance   += row.totalBalance;

            window._ccPdfRows.push([
                row.fundCenterCode + (row.costCenterDescription ? '\n' + row.costCenterDescription : ''),
                fmtC(row.totalAllocatedBudget), fmtC(row.totalBudgetGrant),
                fmtC(row.totalReleases),        relPct  + '%',
                fmtC(row.totalActualExpenditure), utilPct + '%',
                fmtC(row.totalBalance)
            ]);

            const ccCode = esc(row.fundCenterCode);
            const ccDesc = row.costCenterDescription ? esc(row.costCenterDescription) : '';
            tbody.append(
                '<tr data-cc="' + ccCode + '">' +
                '<td class="dt-control text-center" style="cursor:pointer;"><i class="bi bi-plus-circle text-primary"></i></td>' +
                '<td><span class="fw-semibold">' + ccCode + '</span>' +
                    (ccDesc ? '<br><small class="text-muted">' + ccDesc + '</small>' : '') +
                '</td>' +
                '<td class="text-end">' + fmtC(row.totalAllocatedBudget)    + '</td>' +
                '<td class="text-end">' + fmtC(row.totalBudgetGrant)        + '</td>' +
                '<td class="text-end">' + fmtC(row.totalReleases)           + '</td>' +
                '<td class="text-end ' + relCls  + '">' + relPct  + '%</td>' +
                '<td class="text-end text-primary">' + fmtC(row.totalActualExpenditure) + '</td>' +
                '<td class="text-end ' + utilCls + '">' + utilPct + '%</td>' +
                '<td class="text-end">' + fmtC(row.totalBalance)            + '</td>' +
                '<td class="text-center no-print"><button class="btn btn-danger btn-xs py-0 px-1" style="font-size:11px;" onclick="exportGLPdf(\'' + ccCode + '\', \'' + ccDesc + '\')"><i class="bi bi-file-earmark-pdf"></i> PDF</button></td>' +
                '</tr>'
            );
        });

        const totalRelPct  = totAllocated > 0 ? (totReleases / totAllocated * 100).toFixed(1) : '0.0';
        const totalUtilPct = totGrant > 0     ? (totExp / totGrant * 100).toFixed(1)           : '0.0';

        window._ccPdfRows.push(['Total', fmtC(totAllocated), fmtC(totGrant), fmtC(totReleases),
            totalRelPct + '%', fmtC(totExp), totalUtilPct + '%', fmtC(totBalance)]);

        tfoot.append(
            '<tr class="table-secondary">' +
            '<td><strong>Total</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totAllocated) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totGrant)     + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totReleases)  + '</strong></td>' +
            '<td class="text-end ' + utilClass(totalRelPct)  + '"><strong>' + totalRelPct  + '%</strong></td>' +
            '<td class="text-end text-primary"><strong>' + fmtC(totExp)    + '</strong></td>' +
            '<td class="text-end ' + utilClass(totalUtilPct) + '"><strong>' + totalUtilPct + '%</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totBalance)   + '</strong></td>' +
            '</tr>'
        );

        ccDT = $('#ccTable').DataTable({
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'All']],
            order: [[2, 'desc']],
            dom: '<"d-flex justify-content-between align-items-center mb-2"lf>rtip',
            language: { emptyTable: 'No data found', zeroRecords: 'No matching records' },
            columnDefs: [
                { orderable: false, targets: [0, 9] }
            ]
        });

        // Row expand / collapse
        $('#ccTable tbody').off('click', 'td.dt-control').on('click', 'td.dt-control', function () {
            const tr  = $(this).closest('tr');
            const row = ccDT.row(tr);
            const ico = $(this).find('i');
            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
                ico.removeClass('bi-dash-circle text-danger').addClass('bi-plus-circle text-primary');
            } else {
                const ccCode = tr.data('cc');
                loadGLDetail(ccCode, row, ico);
                tr.addClass('shown');
            }
        });
    }

    function updateSummary(data) {
        if (!data.length) { $('#summaryBar').hide(); return; }
        const a = data.reduce((s, r) => ({
            al: s.al + r.totalAllocatedBudget,
            bg: s.bg + r.totalBudgetGrant,
            rl: s.rl + r.totalReleases,
            ex: s.ex + r.totalActualExpenditure,
            bl: s.bl + r.totalBalance
        }), { al: 0, bg: 0, rl: 0, ex: 0, bl: 0 });
        $('#sumAllocated').text(fmtC(a.al));
        $('#sumBudgetGrant').text(fmtC(a.bg));
        $('#sumReleases').text(fmtC(a.rl));
        $('#sumExpenditure').text(fmtC(a.ex));
        $('#sumBalance').text(fmtC(a.bl));
        $('#summaryBar').css('display', '');
    }

    function updatePrintSubtitle(year, fund, cc) {
        const fundLabel = $('#filterFund').find('option:selected').text() || 'All Funds';
        const ccLabel   = $('#filterCC').find('option:selected').text()   || 'All Cost Centers';
        const yearLabel = year || 'All Years';
        const parts = ['Year: ' + yearLabel, 'Grant: ' + fundLabel, 'Cost Center: ' + ccLabel];
        $('#printSubtitle').text(parts.join(' | '));
    }

    function exportPdfReport() {
        const { jsPDF } = window.jspdf;
        const doc   = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const cx    = pageW / 2;

        const year     = $('#filterYear').val() || 'All Years';
        const fundLabel = $('#filterFund').find('option:selected').text() || 'All Funds';
        const ccLabel   = $('#filterCC').find('option:selected').text()   || 'All Cost Centers';
        const _d   = new Date();
        const _mon = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const today = String(_d.getDate()).padStart(2,'0') + ' ' + _mon[_d.getMonth()] + ' ' + _d.getFullYear();

        // ── Header band ────────────────────────────────────────────────────────────
        doc.setFillColor(11, 43, 82);
        doc.rect(0, 0, pageW, 56, 'F');
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(20);
        doc.setTextColor(255, 255, 255);
        doc.text('COST CENTER WISE BUDGET REPORT', cx, 24, { align: 'center' });
        doc.setFontSize(8.5);
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(210, 220, 245);
        doc.text('Year: ' + year + '   |   Grant: ' + fundLabel + '   |   Cost Center: ' + ccLabel + '   |   Generated: ' + today, cx, 42, { align: 'center' });

        // ── Build body from _ccPdfRows (already populated by renderTable) ────────
        const rawRows = window._ccPdfRows || [];
        const body    = [];
        const styles  = {};
        let totA=0, totG=0, totR=0, totE=0, totB=0;

        rawRows.forEach(function (r, i) {
            const isTotal = (i === rawRows.length - 1);
            body.push(r);
            if (isTotal) {
                styles[i] = { fontStyle:'bold', fillColor:[11,43,82], textColor:[255,255,255] };
            } else {
                totA += parseFloat((r[1]||'0').replace(/,/g,''))||0;
                totG += parseFloat((r[2]||'0').replace(/,/g,''))||0;
                totR += parseFloat((r[3]||'0').replace(/,/g,''))||0;
                totE += parseFloat((r[5]||'0').replace(/,/g,''))||0;
                totB += parseFloat((r[7]||'0').replace(/,/g,''))||0;
            }
        });

        // ── Table ────────────────────────────────────────────────────────────
        doc.autoTable({
            head: [[
                { content: 'COST CENTER / DESCRIPTION', styles: { halign: 'left'   } },
                { content: 'ALLOC\nBUDGET',             styles: { halign: 'right'  } },
                { content: 'BUDGET\nGRANT',             styles: { halign: 'right'  } },
                { content: 'RELEASES',                  styles: { halign: 'right'  } },
                { content: '% REL',                     styles: { halign: 'center' } },
                { content: 'EXPENDITURE',               styles: { halign: 'right'  } },
                { content: '% UTIL',                    styles: { halign: 'center' } },
                { content: 'BALANCE',                   styles: { halign: 'right'  } }
            ]],
            body: body,
            startY: 62,
            margin: { left: 8, right: 8, bottom: 24 },
            tableWidth: pageW - 16,
            styles: {
                fontSize: 8,
                cellPadding: { top: 6, bottom: 6, left: 5, right: 5 },
                valign: 'middle',
                lineColor: [220, 225, 235],
                lineWidth: 0.3,
                textColor: [25, 25, 25]
            },
            headStyles: {
                fillColor: [11, 43, 82],
                textColor: [255, 255, 255],
                fontStyle: 'bold',
                fontSize: 8,
                halign: 'center',
                valign: 'middle',
                minCellHeight: 30,
                lineColor: [11, 43, 82],
                lineWidth: 0
            },
            bodyStyles: { halign: 'right' },
            alternateRowStyles: { fillColor: [248, 250, 255] },
            columnStyles: {
                0: { halign: 'left',   cellWidth: 350 },
                1: { halign: 'right',  cellWidth: 95  },
                2: { halign: 'right',  cellWidth: 95  },
                3: { halign: 'right',  cellWidth: 90  },
                4: { halign: 'center', cellWidth: 65  },
                5: { halign: 'right',  cellWidth: 95  },
                6: { halign: 'center', cellWidth: 65  },
                7: { halign: 'right',  cellWidth: 95  }
            },
            didParseCell: function (d) {
                if (d.section === 'head') return;
                const s = styles[d.row.index];
                if (!s) return;
                if (s.fillColor) d.cell.styles.fillColor = s.fillColor;
                if (s.textColor) d.cell.styles.textColor = s.textColor;
                if (s.fontStyle) d.cell.styles.fontStyle = s.fontStyle;
            },
            didDrawPage: function (data) {
                if (data.pageNumber > 1) {
                    doc.setFillColor(11, 43, 82);
                    doc.rect(0, 0, pageW, 28, 'F');
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(11);
                    doc.setTextColor(255, 255, 255);
                    doc.text('COST CENTER WISE BUDGET REPORT  (contd.)', cx, 18, { align: 'center' });
                }
                const pc  = doc.internal.getNumberOfPages();
                const cur = doc.internal.getCurrentPageInfo().pageNumber;
                doc.setFillColor(11, 43, 82);
                doc.rect(0, pageH - 22, pageW, 22, 'F');
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(8);
                doc.setTextColor(245, 248, 252);
                doc.text('Cost Center Wise Budget Report   |   Year: ' + year + '   |   Grant: ' + fundLabel + '   |   Page ' + cur + ' of ' + pc, cx, pageH - 9, { align: 'center' });
            }
        });

        doc.save('CostCenterWise_' + year.replace(/\//g, '-') + '_' + today.replace(/\s/g, '-') + '.pdf');
    }

    function loadGLDetail(ccCode, dtRow, ico) {
        const year = $('#filterYear').val() || null;
        const fund = $('#filterFund').val() || null;
        ico.removeClass('bi-plus-circle text-primary').addClass('bi-arrow-repeat text-secondary');
        ajaxGet('/Reports/GetCostCenterGLDetail',
            { costCenterCode: ccCode, financialYear: year, fundCode: fund },
            function (r) {
                if (!r.success) { showToast('error', r.message || 'Failed to load GL detail.'); return; }
                const rows = r.data;
                let html = '<div class="p-2" style="background:#f0f4ff;">';
                html += '<div class="d-flex justify-content-between align-items-center mb-2">';
                html += '<strong class="text-primary"><i class="bi bi-list-ul me-1"></i>GL Detail — ' + esc(ccCode) + '</strong>';
                html += '<button class="btn btn-danger btn-xs py-0 px-2" style="font-size:11px;" onclick="exportGLPdf(\'' + ccCode + '\', \''+ ccCode +'\')">';
                html += '<i class="bi bi-file-earmark-pdf"></i> Download PDF</button></div>';
                html += '<div style="overflow-x:auto;"><table class="table table-bordered table-sm table-hover mb-0" style="font-size:12px;width:100%;">';
                html += '<thead class="table-primary"><tr>';
                html += '<th>GL Code</th><th>GL Description</th>';
                html += '<th class="text-end">Alloc Budget</th><th class="text-end">Budget Grant</th>';
                html += '<th class="text-end">Releases</th><th class="text-end">% Release</th>';
                html += '<th class="text-end">Expenditure</th><th class="text-end">% Util</th>';
                html += '<th class="text-end">Balance</th>';
                html += '</tr></thead><tbody>';
                let tAl = 0, tBg = 0, tRl = 0, tEx = 0, tBl = 0;
                rows.forEach(function (g) {
                    const rPct = parseFloat(g.releasePercentage).toFixed(1);
                    const uPct = parseFloat(g.utilizationPercentage).toFixed(1);
                    tAl += g.totalAllocatedBudget; tBg += g.totalBudgetGrant;
                    tRl += g.totalReleases;         tEx += g.totalActualExpenditure; tBl += g.totalBalance;
                    html += '<tr>';
                    html += '<td><code>' + esc(g.glCode) + '</code></td>';
                    html += '<td>' + esc(g.glDescription || '—') + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalAllocatedBudget)  + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalBudgetGrant)      + '</td>';
                    html += '<td class="text-end">' + fmtC(g.totalReleases)         + '</td>';
                    html += '<td class="text-end ' + utilClass(rPct) + '">' + rPct + '%</td>';
                    html += '<td class="text-end text-primary">' + fmtC(g.totalActualExpenditure) + '</td>';
                    html += '<td class="text-end ' + utilClass(uPct) + '">' + uPct + '%</td>';
                    html += '<td class="text-end">' + fmtC(g.totalBalance) + '</td>';
                    html += '</tr>';
                });
                const totRPct = tAl > 0 ? (tRl / tAl * 100).toFixed(1) : '0.0';
                const totUPct = tBg > 0 ? (tEx / tBg * 100).toFixed(1) : '0.0';
                html += '<tr class="table-secondary fw-bold">';
                html += '<td colspan="2">Total</td>';
                html += '<td class="text-end">' + fmtC(tAl) + '</td><td class="text-end">' + fmtC(tBg) + '</td>';
                html += '<td class="text-end">' + fmtC(tRl) + '</td><td class="text-end">' + totRPct + '%</td>';
                html += '<td class="text-end">' + fmtC(tEx) + '</td><td class="text-end">' + totUPct + '%</td>';
                html += '<td class="text-end">' + fmtC(tBl) + '</td></tr>';
                html += '</tbody></table></div></div>';

                // store GL rows on DT row for PDF use
                dtRow.data() && (dtRow.node()._glData = { rows: rows, ccCode: ccCode });
                dtRow.child(html).show();
                ico.removeClass('bi-arrow-repeat text-secondary').addClass('bi-dash-circle text-danger');
            });
    }

    function exportGLPdf(ccCode, ccDesc) {
        const year      = $('#filterYear').val() || 'All Years';
        const fundLabel = $('#filterFund').find('option:selected').text() || 'All Funds';
        const _d   = new Date();
        const _mon = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const today = String(_d.getDate()).padStart(2,'0') + ' ' + _mon[_d.getMonth()] + ' ' + _d.getFullYear();

        ajaxGet('/Reports/GetCostCenterGLDetail',
            { costCenterCode: ccCode,
              financialYear: $('#filterYear').val() || null,
              fundCode: $('#filterFund').val() || null },
            function (r) {
                if (!r.success) { showToast('error', 'Failed to load GL data for PDF.'); return; }

                const { jsPDF } = window.jspdf;
                const doc   = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
                const pageW = doc.internal.pageSize.getWidth();
                const pageH = doc.internal.pageSize.getHeight();
                const cx    = pageW / 2;

                // ── Header band ─────────────────────────────────────────────────────
                doc.setFillColor(11, 43, 82);
                doc.rect(0, 0, pageW, 68, 'F');
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(18);
                doc.setTextColor(255, 255, 255);
                doc.text('GL DETAIL REPORT — COST CENTER', cx, 20, { align: 'center' });
                doc.setFontSize(10);
                const nameLabel = (ccDesc && ccDesc !== ccCode) ? ccCode + '  –  ' + ccDesc : ccCode;
                doc.text(nameLabel, cx, 35, { align: 'center' });
                doc.setFontSize(8.5);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(210, 220, 245);
                doc.text('Year: ' + year + '   |   Grant: ' + fundLabel + '   |   Generated: ' + today, cx, 50, { align: 'center' });

                // ── Build body + styles ───────────────────────────────────────────────
                const salary    = r.data.filter(g => g.glCode && g.glCode.startsWith('A01'));
                const nonSalary = r.data.filter(g => !g.glCode || !g.glCode.startsWith('A01'));

                const body   = [];
                const styles = {};
                let idx = 0;
                let tAl=0, tBg=0, tRl=0, tEx=0, tBl=0;

                function addGroup(label, items) {
                    if (!items.length) return;
                    const s = items.reduce((acc, g) => ({
                        a:  acc.a  + g.totalAllocatedBudget,
                        bg: acc.bg + g.totalBudgetGrant,
                        rl: acc.rl + g.totalReleases,
                        ex: acc.ex + g.totalActualExpenditure,
                        bl: acc.bl + g.totalBalance
                    }), { a:0, bg:0, rl:0, ex:0, bl:0 });
                    const rp = s.a  > 0 ? (s.rl / s.a  * 100).toFixed(1) + '%' : '0.0%';
                    const up = s.bg > 0 ? (s.ex / s.bg * 100).toFixed(1) + '%' : '0.0%';
                    body.push([label, '', fmtC(s.a), fmtC(s.bg), fmtC(s.rl), rp, fmtC(s.ex), up, fmtC(s.bl)]);
                    styles[idx++] = { fontStyle:'bold', fillColor:[224,245,224], textColor:[20,70,20] };

                    items.forEach(function (g) {
                        const grp = g.totalAllocatedBudget, gbg = g.totalBudgetGrant;
                        const grl = g.totalReleases, gex = g.totalActualExpenditure, gbl = g.totalBalance;
                        const grp_r = grp > 0 ? (grl / grp * 100).toFixed(1) + '%' : '0.0%';
                        const gup   = gbg > 0 ? (gex / gbg * 100).toFixed(1) + '%' : '0.0%';
                        body.push([g.glCode || '', g.glDescription || '', fmtC(grp), fmtC(gbg), fmtC(grl), grp_r, fmtC(gex), gup, fmtC(gbl)]);
                        styles[idx++] = { fillColor:[255,255,255], textColor:[60,60,60], fontSize:7 };
                        tAl+=grp; tBg+=gbg; tRl+=grl; tEx+=gex; tBl+=gbl;
                    });
                }

                addGroup('Salary',     salary);
                addGroup('Non-Salary', nonSalary);

                const totRp = tAl > 0 ? (tRl/tAl*100).toFixed(1)+'%' : '0.0%';
                const totUp = tBg > 0 ? (tEx/tBg*100).toFixed(1)+'%' : '0.0%';
                body.push(['GRAND TOTAL', '', fmtC(tAl), fmtC(tBg), fmtC(tRl), totRp, fmtC(tEx), totUp, fmtC(tBl)]);
                styles[idx] = { fontStyle:'bold', fillColor:[11,43,82], textColor:[255,255,255] };

                // ── Table ──────────────────────────────────────────────────────
                doc.autoTable({
                    head: [[
                        { content: 'GL CODE',      styles: { halign: 'left'   } },
                        { content: 'GL DESCRIPTION', styles: { halign: 'left'   } },
                        { content: 'ALLOC\nBUDGET', styles: { halign: 'right'  } },
                        { content: 'BUDGET\nGRANT', styles: { halign: 'right'  } },
                        { content: 'RELEASES',      styles: { halign: 'right'  } },
                        { content: '% REL',         styles: { halign: 'center' } },
                        { content: 'EXPENDITURE',   styles: { halign: 'right'  } },
                        { content: '% UTIL',        styles: { halign: 'center' } },
                        { content: 'BALANCE',       styles: { halign: 'right'  } }
                    ]],
                    body: body,
                    startY: 74,
                    margin: { left: 8, right: 8, bottom: 24 },
                    tableWidth: pageW - 16,
                    styles: {
                        fontSize: 8,
                        cellPadding: { top: 6, bottom: 6, left: 5, right: 5 },
                        valign: 'middle',
                        lineColor: [220, 225, 235],
                        lineWidth: 0.3,
                        textColor: [25, 25, 25]
                    },
                    headStyles: {
                        fillColor: [11, 43, 82],
                        textColor: [255, 255, 255],
                        fontStyle: 'bold',
                        fontSize: 8,
                        halign: 'center',
                        valign: 'middle',
                        minCellHeight: 30,
                        lineColor: [11, 43, 82],
                        lineWidth: 0
                    },
                    bodyStyles: { halign: 'right' },
                    alternateRowStyles: { fillColor: [248, 250, 255] },
                    columnStyles: {
                        0: { halign: 'left',   cellWidth: 70  },
                        1: { halign: 'left',   cellWidth: 220 },
                        2: { halign: 'right',  cellWidth: 90  },
                        3: { halign: 'right',  cellWidth: 90  },
                        4: { halign: 'right',  cellWidth: 85  },
                        5: { halign: 'center', cellWidth: 60  },
                        6: { halign: 'right',  cellWidth: 90  },
                        7: { halign: 'center', cellWidth: 60  },
                        8: { halign: 'right',  cellWidth: 90  }
                    },
                    didParseCell: function (d) {
                        if (d.section === 'head') return;
                        const s = styles[d.row.index];
                        if (!s) return;
                        if (s.fillColor) d.cell.styles.fillColor = s.fillColor;
                        if (s.textColor) d.cell.styles.textColor = s.textColor;
                        if (s.fontStyle) d.cell.styles.fontStyle = s.fontStyle;
                        if (s.fontSize)  d.cell.styles.fontSize  = s.fontSize;
                    },
                    didDrawPage: function (data) {
                        if (data.pageNumber > 1) {
                            doc.setFillColor(11, 43, 82);
                            doc.rect(0, 0, pageW, 28, 'F');
                            doc.setFont('helvetica', 'bold');
                            doc.setFontSize(11);
                            doc.setTextColor(255, 255, 255);
                            doc.text('GL DETAIL REPORT  (contd.)  —  ' + ccCode, cx, 18, { align: 'center' });
                        }
                        const pc  = doc.internal.getNumberOfPages();
                        const cur = doc.internal.getCurrentPageInfo().pageNumber;
                        doc.setFillColor(11, 43, 82);
                        doc.rect(0, pageH - 22, pageW, 22, 'F');
                        doc.setFont('helvetica', 'normal');
                        doc.setFontSize(8);
                        doc.setTextColor(245, 248, 252);
                        doc.text('GL Detail — ' + ccCode + '   |   Year: ' + year + '   |   Grant: ' + fundLabel + '   |   Page ' + cur + ' of ' + pc, cx, pageH - 9, { align: 'center' });
                    }
                });

                doc.save('GLDetail_' + ccCode + '_' + year.replace(/\//g, '-') + '_' + today.replace(/\s/g, '-') + '.pdf');
            });
    }

    function clearFilters() {
        $('#filterYear').val('');
        $('#filterFund').val('').trigger('change');
        $('#filterCC').val('').trigger('change');
        loadFundDropdown(null);
        loadCCDropdown(null, null);
        loadData();
    }

    function printFiltered() {
        const year      = $('#filterYear').val() || 'All Years';
        const fundLabel = $('#filterFund').find('option:selected').text() || 'All Funds';
        const ccLabel   = $('#filterCC').find('option:selected').text()   || 'All Cost Centers';

        // Gather visible (filtered) rows from DataTable
        let tableHtml = '<table style="width:100%;border-collapse:collapse;font-size:10pt;">';
        tableHtml += '<thead><tr style="background:#1e3250;color:#fff;">';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;">Cost Center</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">Allocated Budget</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">Budget Grant</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">Releases</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">% Release</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">Expenditure</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">% Util</th>';
        tableHtml += '<th style="padding:5px;border:1px solid #ccc;text-align:right;">Balance</th>';
        tableHtml += '</tr></thead><tbody>';

        ccDT.rows({ search: 'applied' }).every(function () {
            const $tr = $(this.node());
            const cells = $tr.find('td');
            if (cells.length < 9) return;
            const even = this.index() % 2 === 0;
            const bg   = even ? '#fff' : '#f5f7fb';
            tableHtml += '<tr style="background:' + bg + ';">';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;">' + cells.eq(1).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(2).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(3).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(4).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(5).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(6).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(7).text() + '</td>';
            tableHtml += '<td style="padding:4px;border:1px solid #ccc;text-align:right;">' + cells.eq(8).text() + '</td>';
            tableHtml += '</tr>';
        });

        tableHtml += '</tbody></table>';

        const w = window.open('', '_blank', 'width=1100,height=750');
        w.document.write(
            '<html><head><title>Cost Center Wise — Print</title>' +
            '<style>body{font-family:Arial,sans-serif;margin:20px;} h3{margin-bottom:4px;} p{margin:0 0 10px;font-size:9pt;color:#555;}</style>' +
            '</head><body>' +
            '<h3>Cost Center Wise Budget Report</h3>' +
            '<p>Year: ' + year + ' &nbsp;|&nbsp; Grant: ' + fundLabel + ' &nbsp;|&nbsp; Cost Center: ' + ccLabel + '</p>' +
            tableHtml +
            '<script>window.onload=function(){window.print();window.close();}<\/script>' +
            '</body></html>'
        );
        w.document.close();
    }

    function exportExcel() {
        const year = $('#filterYear').val() || '';
        const fund = $('#filterFund').val() || '';
        const cc   = $('#filterCC').val()   || '';
        window.location.href = '/Reports/ExportExcel?reportType=costcenter'
            + (year ? '&financialYear=' + year : '')
            + (fund ? '&fundCode='      + fund : '')
            + (cc   ? '&costCenterCode=' + cc   : '');
    }

    function fmtC(v) { return Math.round(parseFloat(v) || 0).toLocaleString('en-PK'); }
    function esc(s)  { return $('<span>').text(s).html(); }
    function utilClass(pct) {
        const n = parseFloat(pct);
        if (n >= 90) return 'pct-danger';
        if (n >= 70) return 'pct-warning';
        return 'pct-ok';
    }
</script>
}
