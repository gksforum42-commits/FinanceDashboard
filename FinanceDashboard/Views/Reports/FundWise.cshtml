@{
    ViewData["Title"] = "Fund Wise Report";
}

<div class="fade-in" id="reportWrapper">

    <!-- Page Header -->
    <div class="page-header no-print">
        <div>
            <h2 class="page-title"><i class="bi bi-wallet2 me-2"></i>Fund Wise Report</h2>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-success btn-sm" onclick="exportExcel()">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportPdfReport()">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Print Header (visible only when printing / PDF) -->
    <div class="print-only mb-3">
        <h4 class="mb-0">Fund Wise Budget Report</h4>
        <small id="printSubtitle" class="text-muted"></small>
    </div>

    <!-- Filters -->
    <div class="filter-bar no-print">
        <div class="filter-form">
            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <select id="filterYear" class="form-select form-select-sm">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Sector</label>
                <select id="filterSector" class="form-select form-select-sm select2" style="min-width:160px;">
                    <option value="">All Sectors</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fund</label>
                <select id="filterFund" class="form-select form-select-sm select2" style="min-width:220px;">
                    <option value="">All Funds</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary btn-sm" onclick="loadData()">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Totals Bar -->
    <div class="totals-banner mb-3 no-print" id="summaryBar" style="display:none!important;">
        <div class="totals-item"><i class="bi bi-cash-stack text-primary me-1"></i><span class="text-muted me-1">Alloc Budget:</span><strong id="sumAllocated">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-clipboard-check text-info me-1"></i><span class="text-muted me-1">Budget Grant:</span><strong id="sumBudgetGrant">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-arrow-down-circle text-success me-1"></i><span class="text-muted me-1">Releases:</span><strong id="sumReleases">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-receipt text-danger me-1"></i><span class="text-muted me-1">Expenditure:</span><strong id="sumExpenditure">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-piggy-bank text-success me-1"></i><span class="text-muted me-1">Balance:</span><strong id="sumBalance">—</strong></div>
    </div>

    <!-- Data Table -->
    <div class="table-container" style="overflow-x:auto;">
        <table id="fundTable" class="table table-bordered table-sm table-hover print-table nowrap" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>Grant</th>
                    <th class="text-end">Allocation</th>
                    <th class="text-end">Budget Grant</th>
                    <th class="text-end">Releases</th>
                    <th class="text-end">% Release</th>
                    <th class="text-end">Supplementary</th>
                    <th class="text-end">Reapp (+)</th>
                    <th class="text-end">Reapp (-)</th>
                    <th class="text-end">Surrender</th>
                    <th class="text-end">Final Budget</th>
                    <th class="text-end">Expenditure</th>
                    <th class="text-end">% Utilization</th>
                    <th class="text-end">Balance</th>
                </tr>
            </thead>
            <tbody id="fundTableBody"></tbody>
            <tfoot id="fundTableFoot"></tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
    /* Print / PDF styles */
    @@media print {
        .no-print, .page-header, .filter-bar, .sidebar, nav, header, footer { display: none !important; }
        .print-only { display: block !important; }
        body, .main-content, .content-wrapper { margin: 0; padding: 0; }
        .table-container { overflow: visible !important; }
        #fundTable { font-size: 9pt; width: 100% !important; }
        #fundTable thead { background: #343a40 !important; color: #fff !important; -webkit-print-color-adjust: exact; }
        #fundTable tfoot td { font-weight: bold; background: #f8f9fa; -webkit-print-color-adjust: exact; }
        /* Force all DataTable pages to print */
        .dataTables_paginate, .dataTables_filter, .dataTables_info,
        .dataTables_length { display: none !important; }
        table.dataTable tbody tr { display: table-row !important; }
    }
    .print-only { display: none; }
    .pct-danger { color: #dc3545; font-weight: 600; }
    .pct-warning { color: #fd7e14; font-weight: 600; }
    .pct-ok { color: #198754; font-weight: 600; }
    tfoot td { font-weight: 700; background: #f8f9fa; }
</style>
<script>
    let fundDT = null;

    $(document).ready(function () {
        // Load financial years
        ajaxGet('/Dashboard/GetFinancialYears', {}, function (r) {
            if (!r.success) return;
            const sel = $('#filterYear');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
        });

        // Initialize Select2
        $('#filterSector').select2({ theme: 'bootstrap-5', placeholder: 'All Sectors', allowClear: true, width: '100%' });
        $('#filterFund').select2({   theme: 'bootstrap-5', placeholder: 'All Funds',   allowClear: true, width: '100%' });

        loadSectorDropdown(null);
        loadFundDropdown(null, null);

        // When year changes, refresh dropdowns and data
        $('#filterYear').on('change', function () {
            const yr = $(this).val() || null;
            loadSectorDropdown(yr);
            loadFundDropdown(yr, null);
            loadData();
        });

        // When sector changes, reload fund filtered by sector
        $('#filterSector').on('change', function () {
            const yr = $('#filterYear').val() || null;
            const s  = $(this).val() || null;
            $('#filterFund').val('').trigger('change.select2');
            loadFundDropdown(yr, s);
        });

        loadData();
    });

    function loadSectorDropdown(year) {
        const params = year ? { financialYear: year } : {};
        ajaxGet('/Dashboard/GetSectorLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterSector');
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Sectors</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Sectors', allowClear: true, width: '100%' });
        });
    }

    function loadFundDropdown(year, sector) {
        const params = {};
        if (year)   params.financialYear = year;
        if (sector) params.sector = sector;
        ajaxGet('/Dashboard/GetFundLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterFund');
            const current = sel.val();
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Funds</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Funds', allowClear: true, width: '100%' });
            if (current) sel.val(current).trigger('change.select2');
        });
    }

    function loadData() {
        const year     = $('#filterYear').val()   || null;
        const sector   = $('#filterSector').val() || null;
        const fundCode = $('#filterFund').val()   || null;

        ajaxGet('/Reports/GetFundWiseData',
            { financialYear: year, sector: sector, fundCode: fundCode },
            function (r) {
                if (r.success) {
                    renderTable(r.data);
                    updateSummary(r.data);
                    updatePrintSubtitle(year, sector, fundCode);
                } else {
                    showToast('error', r.message || 'Failed to load data.');
                }
            });
    }

    function renderTable(data) {
        if (fundDT) { fundDT.destroy(); fundDT = null; }

        const tbody = $('#fundTableBody');
        const tfoot = $('#fundTableFoot');
        tbody.empty();
        tfoot.empty();

        let totAllocated = 0, totGrant = 0, totReleases = 0, totExp = 0, totBalance = 0;
        let totSupp = 0, totReappPlus = 0, totReappMinus = 0, totSurr = 0, totFinalGrant = 0;
        window._fundPdfRows = [];   // store plain-text rows for PDF export

        data.forEach(function (row) {
            const relPct   = parseFloat(row.releasePercentage).toFixed(1);
            const utilPct  = parseFloat(row.utilizationPercentage).toFixed(1);
            const relCls   = utilClass(relPct);
            const utilCls  = utilClass(utilPct);

            totAllocated += row.totalAllocatedBudget;
            totGrant     += row.totalBudgetGrant;
            totReleases  += row.totalReleases;
            totExp       += row.totalActualExpenditure;
            totBalance   += row.totalBalance;
            totSupp        += row.totalSupplementaryGrant;
            totReappPlus   += row.totalReappropriationPlus;
            totReappMinus  += row.totalReappropriationMinus;
            totSurr        += row.totalSurrender;
            totFinalGrant  += row.totalFinalGrant;

            const grantLabel = row.fundCode + (row.fundDes ? '\n' + row.fundDes : '');

            // Store for PDF (plain text)
            window._fundPdfRows.push([
                grantLabel,
                fmtC(row.totalAllocatedBudget),
                fmtC(row.totalBudgetGrant),
                fmtC(row.totalReleases),
                relPct + '%',
                fmtC(row.totalSupplementaryGrant),
                fmtC(row.totalReappropriationPlus),
                fmtC(row.totalReappropriationMinus),
                fmtC(row.totalSurrender),
                fmtC(row.totalFinalGrant),
                fmtC(row.totalActualExpenditure),
                utilPct + '%',
                fmtC(row.totalBalance)
            ]);

            tbody.append(
                '<tr>' +
                '<td><span class="fw-semibold">' + esc(row.fundCode) + '</span>' +
                    (row.fundDes ? '<br><small class="text-muted">' + esc(row.fundDes) + '</small>' : '') +
                '</td>' +
                '<td class="text-end">' + fmtC(row.totalAllocatedBudget) + '</td>' +
                '<td class="text-end">' + fmtC(row.totalBudgetGrant) + '</td>' +
                '<td class="text-end">' + fmtC(row.totalReleases) + '</td>' +
                '<td class="text-end ' + relCls + '">' + relPct + '%</td>' +
                '<td class="text-end">' + fmtC(row.totalSupplementaryGrant) + '</td>' +
                '<td class="text-end">' + fmtC(row.totalReappropriationPlus) + '</td>' +
                '<td class="text-end">' + fmtC(row.totalReappropriationMinus) + '</td>' +
                '<td class="text-end">' + fmtC(row.totalSurrender) + '</td>' +
                '<td class="text-end">' + fmtC(row.totalFinalGrant) + '</td>' +
                '<td class="text-end text-primary">' + fmtC(row.totalActualExpenditure) + '</td>' +
                '<td class="text-end ' + utilCls + '">' + utilPct + '%</td>' +
                '<td class="text-end">' + fmtC(row.totalBalance) + '</td>' +
                '</tr>'
            );
        });

        // Totals footer row
        const totalRelPct  = totAllocated > 0 ? (totReleases / totAllocated * 100).toFixed(1) : '0.0';
        const totalUtilPct = totFinalGrant > 0 ? (totExp / totFinalGrant * 100).toFixed(1)     : '0.0';
        const footRow = [
            'Total',
            fmtC(totAllocated), fmtC(totGrant), fmtC(totReleases), totalRelPct + '%',
            fmtC(totSupp), fmtC(totReappPlus), fmtC(totReappMinus), fmtC(totSurr), fmtC(totFinalGrant),
            fmtC(totExp), totalUtilPct + '%', fmtC(totBalance)
        ];
        window._fundPdfRows.push(footRow);   // last row = totals (styled bold in PDF)

        tfoot.append(
            '<tr class="table-secondary">' +
            '<td><strong>Total</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totAllocated) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totGrant) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totReleases) + '</strong></td>' +
            '<td class="text-end ' + utilClass(totalRelPct) + '"><strong>' + totalRelPct + '%</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totSupp) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totReappPlus) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totReappMinus) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totSurr) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totFinalGrant) + '</strong></td>' +
            '<td class="text-end text-primary"><strong>' + fmtC(totExp) + '</strong></td>' +
            '<td class="text-end ' + utilClass(totalUtilPct) + '"><strong>' + totalUtilPct + '%</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totBalance) + '</strong></td>' +
            '</tr>'
        );

        fundDT = $('#fundTable').DataTable({
            pageLength: 25,
            order: [[1, 'desc']],
            scrollX: true,
            dom: '<"d-flex justify-content-between align-items-center mb-2"lf>rtip',
            language: { emptyTable: 'No data found', zeroRecords: 'No matching records' }
        });
    }

    function updateSummary(data) {
        if (!data.length) { $('#summaryBar').hide(); return; }
        const a = data.reduce((s, r) => ({
            al: s.al + r.totalAllocatedBudget,
            bg: s.bg + r.totalBudgetGrant,
            rl: s.rl + r.totalReleases,
            ex: s.ex + r.totalActualExpenditure,
            bl: s.bl + r.totalBalance
        }), { al: 0, bg: 0, rl: 0, ex: 0, bl: 0 });
        $('#sumAllocated').text(fmtC(a.al));
        $('#sumBudgetGrant').text(fmtC(a.bg));
        $('#sumReleases').text(fmtC(a.rl));
        $('#sumExpenditure').text(fmtC(a.ex));
        $('#sumBalance').text(fmtC(a.bl));
        $('#summaryBar').css('display', '');
    }

    function updatePrintSubtitle(year, sector, fundCode) {
        const parts = [];
        if (year)     parts.push('Year: ' + year);
        if (sector)   parts.push('Sector: ' + sector);
        if (fundCode) parts.push('Fund: ' + fundCode);
        $('#printSubtitle').text(parts.length ? parts.join(' | ') : 'All Years — All Funds');
    }

    function exportPdfReport() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
        const pageW = doc.internal.pageSize.width;

        const year = $('#filterYear').val() || 'All Years';
        const fund = $('#filterFund').val() || 'All Funds';
        const now  = new Date().toLocaleDateString('en-PK');

        // Colour scheme (matches ObjectWise / CostCenterWise reports)
        const C_NAVY    = [11, 43, 82];
        const C_WHITE   = [255, 255, 255];
        const C_DARK    = [25, 25, 25];
        const C_ALTROW  = [248, 250, 255];
        const C_TOTAL   = [220, 230, 245];

        // Title block
        doc.setFillColor(...C_NAVY);
        doc.rect(0, 0, pageW, 30, 'F');
        doc.setFontSize(14); doc.setFont('helvetica', 'bold');
        doc.setTextColor(...C_WHITE);
        doc.text('Fund Wise Budget Report', 40, 20);
        doc.setFontSize(9); doc.setFont('helvetica', 'normal');
        doc.setTextColor(...C_DARK);
        doc.text('Financial Year: ' + year + '   |   Fund: ' + fund, 40, 46);
        doc.text('Generated: ' + now, doc.internal.pageSize.width - 40, 46, { align: 'right' });

        // Build rows from the stored pdfRows array (set during renderTable)
        const headers = [['Grant', 'Allocation', 'Budget Grant', 'Releases', '% Release',
                          'Supplementary', 'Reapp (+)', 'Reapp (-)', 'Surrender', 'Final Budget',
                          'Expenditure', '% Utilization', 'Balance']];

        // Proportional column weights scaled to the page width so the table always fits on one page.
        const L_MARGIN = 40, R_MARGIN = 40;
        const colWeights = [140, 75, 75, 70, 48, 70, 65, 65, 65, 75, 75, 55, 75];
        const weightSum = colWeights.reduce((a, b) => a + b, 0);
        const tableW = pageW - L_MARGIN - R_MARGIN;
        const colWidths = colWeights.map(w => (w / weightSum) * tableW);
        const lastRowIndex = (window._fundPdfRows || []).length - 1;

        doc.autoTable({
            head: headers,
            body: window._fundPdfRows || [],
            startY: 58,
            margin: { left: L_MARGIN, right: R_MARGIN },
            tableWidth: tableW,
            horizontalPageBreak: false,
            styles: {
                fontSize: 7,
                cellPadding: 3,
                lineColor: [220, 225, 235],
                lineWidth: 0.3,
                textColor: C_DARK
            },
            headStyles: {
                fillColor: C_NAVY,
                textColor: C_WHITE,
                fontStyle: 'bold',
                halign: 'center'
            },
            alternateRowStyles: { fillColor: C_ALTROW },
            columnStyles: {
                0: { cellWidth: colWidths[0] },
                1: { cellWidth: colWidths[1],  halign: 'right' },
                2: { cellWidth: colWidths[2],  halign: 'right' },
                3: { cellWidth: colWidths[3],  halign: 'right' },
                4: { cellWidth: colWidths[4],  halign: 'right' },
                5: { cellWidth: colWidths[5],  halign: 'right' },
                6: { cellWidth: colWidths[6],  halign: 'right' },
                7: { cellWidth: colWidths[7],  halign: 'right' },
                8: { cellWidth: colWidths[8],  halign: 'right' },
                9: { cellWidth: colWidths[9],  halign: 'right' },
                10: { cellWidth: colWidths[10], halign: 'right' },
                11: { cellWidth: colWidths[11], halign: 'right' },
                12: { cellWidth: colWidths[12], halign: 'right' }
            },
            didParseCell: function (data) {
                if (data.row.index === lastRowIndex) {
                    data.cell.styles.fontStyle = 'bold';
                    data.cell.styles.fillColor = C_TOTAL;
                    data.cell.styles.textColor = C_DARK;
                }
            },
            didDrawPage: function () {
                const pc = doc.internal.getNumberOfPages();
                doc.setFontSize(7);
                doc.text('Page ' + doc.internal.getCurrentPageInfo().pageNumber + ' of ' + pc,
                    doc.internal.pageSize.width / 2, doc.internal.pageSize.height - 10, { align: 'center' });
            }
        });

        doc.save('FundWise_' + year.replace(/\s/g,'') + '_' + now.replace(/\//g,'-') + '.pdf');
    }

    function clearFilters() {
        $('#filterYear').val('');
        if ($('#filterSector').hasClass('select2-hidden-accessible')) $('#filterSector').val('').trigger('change.select2');
        if ($('#filterFund').hasClass('select2-hidden-accessible'))   $('#filterFund').val('').trigger('change.select2');
        loadSectorDropdown(null);
        loadFundDropdown(null, null);
        loadData();
    }

    function exportExcel() {
        const year   = $('#filterYear').val()   || '';
        const sector = $('#filterSector').val() || '';
        const fund   = $('#filterFund').val()   || '';
        window.location.href = '/Reports/ExportExcel?reportType=fund'
            + (year   ? '&financialYear=' + year   : '')
            + (sector ? '&sector=' + encodeURIComponent(sector) : '')
            + (fund   ? '&fundCode=' + fund : '');
    }

    // Helpers
    function fmtC(v) { return Math.round(parseFloat(v) || 0).toLocaleString('en-PK'); }
    function esc(s) { return $('<span>').text(s).html(); }
    function utilClass(pct) {
        const n = parseFloat(pct);
        if (n >= 90) return 'pct-danger';
        if (n >= 70) return 'pct-warning';
        return 'pct-ok';
    }
</script>
}
