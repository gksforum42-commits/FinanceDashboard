@{
    ViewData["Title"] = "Object Wise Report";
}

<div class="fade-in" id="reportWrapper">

    <!-- Page Header -->
    <div class="page-header no-print">
        <div>
            <h2 class="page-title"><i class="bi bi-box-seam me-2"></i>Object Wise Report</h2>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-success btn-sm" onclick="exportExcel()">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportPdfReport()">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Print Header -->
    <div class="print-only mb-3">
        <h4 class="mb-0">Object Wise Budget Report</h4>
        <small id="printSubtitle" class="text-muted"></small>
    </div>

    <!-- Filters -->
    <div class="filter-bar no-print">
        <div class="filter-form">
            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <select id="filterYear" class="form-select form-select-sm">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Sector</label>
                <select id="filterSector" class="form-select form-select-sm select2" style="min-width:160px;">
                    <option value="">All Sectors</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Department</label>
                <select id="filterDept" class="form-select form-select-sm select2" style="min-width:200px;">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fund</label>
                <select id="filterFund" class="form-select form-select-sm select2" style="min-width:220px;">
                    <option value="">All Funds</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Cost Center</label>
                <select id="filterCC" class="form-select form-select-sm select2" style="min-width:240px;">
                    <option value="">All Cost Centers</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Object Code</label>
                <select id="filterObj" class="form-select form-select-sm select2" style="min-width:200px;" disabled>
                    <option value="">All Object Codes</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary btn-sm" onclick="loadData()">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                    <i class="bi bi-x-circle me-1"></i>Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Totals Bar -->
    <div class="totals-banner mb-3 no-print" id="summaryBar" style="display:none!important;">
        <div class="totals-item"><i class="bi bi-cash-stack text-primary me-1"></i><span class="text-muted me-1">Alloc Budget:</span><strong id="sumAllocated">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-clipboard-check text-info me-1"></i><span class="text-muted me-1">Budget Grant:</span><strong id="sumBudgetGrant">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-arrow-down-circle text-success me-1"></i><span class="text-muted me-1">Releases:</span><strong id="sumReleases">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-receipt text-danger me-1"></i><span class="text-muted me-1">Expenditure:</span><strong id="sumExpenditure">—</strong></div>
        <div class="totals-divider"></div>
        <div class="totals-item"><i class="bi bi-piggy-bank text-success me-1"></i><span class="text-muted me-1">Balance:</span><strong id="sumBalance">—</strong></div>
    </div>

    <!-- Data Table -->
    <div class="table-container" style="overflow-x:auto;">
        <div id="tableLoadingOverlay">
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div class="mt-2 text-primary fw-semibold">Loading data...</div>
            </div>
        </div>
        <table id="objTable" class="table table-bordered table-sm table-hover print-table nowrap" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>GL Code</th>
                    <th>GL Description</th>
                    <th class="text-end">Alloc Budget</th>
                    <th class="text-end">Budget Grant</th>
                    <th class="text-end">Releases</th>
                    <th class="text-end">% Release</th>
                    <th class="text-end">Expenditure</th>
                    <th class="text-end">% Util</th>
                    <th class="text-end">Balance</th>
                </tr>
            </thead>
            <tbody id="objTableBody"></tbody>
            <tfoot id="objTableFoot"></tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
    @@media print {
        .no-print, .page-header, .filter-bar, .sidebar, nav, header, footer { display: none !important; }
        .print-only { display: block !important; }
        body, .main-content, .content-wrapper { margin: 0; padding: 0; }
        .table-container { overflow: visible !important; }
        #objTable { font-size: 9pt; width: 100% !important; }
        #objTable thead { background: #343a40 !important; color: #fff !important; -webkit-print-color-adjust: exact; }
        #objTable tfoot td { font-weight: bold; background: #f8f9fa; -webkit-print-color-adjust: exact; }
        .dataTables_paginate, .dataTables_filter, .dataTables_info, .dataTables_length { display: none !important; }
        table.dataTable tbody tr { display: table-row !important; }
    }
    .print-only  { display: none; }
    .pct-danger  { color: #dc3545; font-weight: 600; }
    .pct-warning { color: #fd7e14; font-weight: 600; }
    .pct-ok      { color: #198754; font-weight: 600; }
    tfoot td     { font-weight: 700; background: #f8f9fa; }
    #tableLoadingOverlay {
        display: none;
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.75);
        z-index: 10;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
    }
    #tableLoadingOverlay.active { display: flex; }
    .table-container { position: relative; }
</style>
<script>
    let objDT = null;

    function showTableLoading() { $('#tableLoadingOverlay').addClass('active'); }
    function hideTableLoading()  { $('#tableLoadingOverlay').removeClass('active'); }

    $(document).ready(function () {
        ajaxGet('/Dashboard/GetFinancialYears', {}, function (r) {
            if (!r.success) return;
            const sel = $('#filterYear');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
        });

        $('#filterSector').select2({ theme: 'bootstrap-5', placeholder: 'All Sectors',      allowClear: true, width: '100%' });
        $('#filterDept').select2(  { theme: 'bootstrap-5', placeholder: 'All Departments',  allowClear: true, width: '100%' });
        $('#filterFund').select2(  { theme: 'bootstrap-5', placeholder: 'All Funds',         allowClear: true, width: '100%' });
        $('#filterCC').select2(    { theme: 'bootstrap-5', placeholder: 'All Cost Centers',  allowClear: true, width: '100%' });
        $('#filterObj').select2(   { theme: 'bootstrap-5', placeholder: 'All Object Codes',  allowClear: true, width: '100%' });

        loadSectorDropdown(null);
        loadDeptDropdown(null, null);
        loadFundDropdown(null, null, null);
        loadCCDropdown(null, null);

        $('#filterYear').on('change', function () {
            const yr = $(this).val() || null;
            loadSectorDropdown(yr);
            loadDeptDropdown(yr, null);
            loadFundDropdown(yr, null, null);
            loadCCDropdown(yr, null);
            resetObjDropdown();
            loadData();
        });
        $('#filterSector').on('change', function () {
            const yr = $('#filterYear').val() || null;
            const s  = $(this).val() || null;
            $('#filterDept').val('').trigger('change.select2');
            $('#filterFund').val('').trigger('change.select2');
            $('#filterCC').val('').trigger('change.select2');
            loadDeptDropdown(yr, s);
            loadFundDropdown(yr, null, s);
            loadCCDropdown(yr, null);
            resetObjDropdown();
        });
        $('#filterDept').on('change', function () {
            const yr = $('#filterYear').val() || null;
            const s  = $('#filterSector').val() || null;
            const d  = $(this).val() || null;
            $('#filterFund').val('').trigger('change.select2');
            $('#filterCC').val('').trigger('change.select2');
            loadFundDropdown(yr, d, s);
            loadCCDropdown(yr, null);
            resetObjDropdown();
            loadData();
        });
        $('#filterFund').on('change', function () {
            const yr = $('#filterYear').val() || null;
            const fc = $(this).val() || null;
            $('#filterCC').val('').trigger('change.select2');
            loadCCDropdown(yr, fc);
            resetObjDropdown();
            loadData();
        });
        $('#filterCC').on('change', function () {
            resetObjDropdown();
            loadData();
        });
        $('#filterObj').on('change', function () { loadData(); });

        loadData();
    });

    function loadSectorDropdown(year) {
        const params = year ? { financialYear: year } : {};
        ajaxGet('/Dashboard/GetSectorLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterSector');
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Sectors</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Sectors', allowClear: true, width: '100%' });
        });
    }

    function loadDeptDropdown(year, sector) {
        const params = {};
        if (year)   params.financialYear = year;
        if (sector) params.sector = sector;
        ajaxGet('/Dashboard/GetDepartmentLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterDept');
            const cur = sel.val();
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Departments</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Departments', allowClear: true, width: '100%' });
            if (cur) sel.val(cur).trigger('change.select2');
        });
    }

    function loadFundDropdown(year, departmentCode, sector) {
        const params = {};
        if (year)           params.financialYear = year;
        if (sector)         params.sector = sector;
        if (departmentCode) params.departmentCode = departmentCode;
        ajaxGet('/Dashboard/GetFundLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterFund');
            const cur = sel.val();
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Funds</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Funds', allowClear: true, width: '100%' });
            if (cur) sel.val(cur).trigger('change.select2');
        });
    }

    function loadCCDropdown(year, fundCode) {
        const params = {};
        if (year)     params.financialYear = year;
        if (fundCode) params.fundCode      = fundCode;
        ajaxGet('/Dashboard/GetCostCenterLookup', params, function (r) {
            if (!r.success) return;
            const sel = $('#filterCC');
            const cur = sel.val();
            if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
            sel.empty().append('<option value="">All Cost Centers</option>');
            r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
            sel.select2({ theme: 'bootstrap-5', placeholder: 'All Cost Centers', allowClear: true, width: '100%' });
            if (cur) sel.val(cur).trigger('change.select2');
        });
    }

    function resetObjDropdown() {
        const sel = $('#filterObj');
        if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
        sel.val('').empty().append('<option value="">All Object Codes</option>');
        sel.prop('disabled', true)
           .select2({ theme: 'bootstrap-5', placeholder: 'All Object Codes', allowClear: true, width: '100%' });
    }

    function populateObjDropdown(data) {
        const sel = $('#filterObj');
        const cur = sel.val();
        if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
        sel.empty().append('<option value="">All Object Codes</option>');
        data.forEach(function (row) {
            const label = row.detailObject + (row.objectDescription ? ' – ' + row.objectDescription : '');
            sel.append('<option value="' + esc(row.detailObject) + '">' + label + '</option>');
        });
        sel.prop('disabled', data.length === 0);
        sel.select2({ theme: 'bootstrap-5', placeholder: 'All Object Codes', allowClear: true, width: '100%' });
        if (cur && data.some(r => r.detailObject === cur)) sel.val(cur).trigger('change.select2');
    }

    function loadData() {
        const year   = $('#filterYear').val()   || null;
        const sector = $('#filterSector').val() || null;
        const dept   = $('#filterDept').val()   || null;
        const fund   = $('#filterFund').val()   || null;
        const cc     = $('#filterCC').val()     || null;
        const obj    = $('#filterObj').val()    || null;
        showTableLoading();
        ajaxGet('/Reports/GetObjectWiseData',
            { financialYear: year, sector: sector, departmentCode: dept, fundCode: fund, costCenterCode: cc, keyword: obj },
            function (r) {
                hideTableLoading();
                if (r.success) {
                    // Populate object dropdown only when no object is pre-selected
                    if (!obj) populateObjDropdown(r.data);
                    renderTable(r.data);
                    updateSummary(r.data);
                    updatePrintSubtitle(year, sector, dept, fund, cc, obj);
                } else {
                    showToast('error', r.message || 'Failed to load data.');
                }
            },
            function () {
                hideTableLoading();
                showToast('error', 'Failed to load data.');
            });
    }

    function renderTable(data) {
        if (objDT) { objDT.destroy(); objDT = null; }

        const tbody = $('#objTableBody');
        const tfoot = $('#objTableFoot');
        tbody.empty();
        tfoot.empty();

        let totAllocated = 0, totGrant = 0, totReleases = 0, totExp = 0, totBalance = 0;
        window._objPdfRows = [];

        data.forEach(function (row) {
            const relPct  = parseFloat(row.releasePercentage).toFixed(1);
            const utilPct = parseFloat(row.utilizationPercentage).toFixed(1);
            const relCls  = utilClass(relPct);
            const utilCls = utilClass(utilPct);

            totAllocated += row.totalAllocatedBudget;
            totGrant     += row.totalBudgetGrant;
            totReleases  += row.totalReleases;
            totExp       += row.totalActualExpenditure;
            totBalance   += row.totalBalance;

            window._objPdfRows.push([
                row.detailObject,
                row.objectDescription || '—',
                fmtC(row.totalAllocatedBudget), fmtC(row.totalBudgetGrant),
                fmtC(row.totalReleases), relPct + '%',
                fmtC(row.totalActualExpenditure), utilPct + '%',
                fmtC(row.totalBalance)
            ]);

            const objCode = esc(row.detailObject);
            const objDesc = row.objectDescription ? esc(row.objectDescription) : '';
            tbody.append(
                '<tr>' +
                '<td><code class="fw-semibold">' + objCode + '</code></td>' +
                '<td>' + (objDesc ? objDesc : '<span class="text-muted">—</span>') + '</td>' +
                '<td class="text-end">' + fmtC(row.totalAllocatedBudget)     + '</td>' +
                '<td class="text-end">' + fmtC(row.totalBudgetGrant)         + '</td>' +
                '<td class="text-end">' + fmtC(row.totalReleases)            + '</td>' +
                '<td class="text-end ' + relCls  + '">' + relPct  + '%</td>' +
                '<td class="text-end text-primary">' + fmtC(row.totalActualExpenditure) + '</td>' +
                '<td class="text-end ' + utilCls + '">' + utilPct + '%</td>' +
                '<td class="text-end">' + fmtC(row.totalBalance)             + '</td>' +
                '</tr>'
            );
        });

        const totalRelPct  = totAllocated > 0 ? (totReleases / totAllocated * 100).toFixed(1) : '0.0';
        const totalUtilPct = totGrant     > 0 ? (totExp      / totGrant     * 100).toFixed(1) : '0.0';

        window._objPdfRows.push(['Total', '', fmtC(totAllocated), fmtC(totGrant), fmtC(totReleases),
            totalRelPct + '%', fmtC(totExp), totalUtilPct + '%', fmtC(totBalance)]);

        tfoot.append(
            '<tr class="table-secondary">' +
            '<td colspan="2"><strong>Total</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totAllocated) + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totGrant)     + '</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totReleases)  + '</strong></td>' +
            '<td class="text-end ' + utilClass(totalRelPct)  + '"><strong>' + totalRelPct  + '%</strong></td>' +
            '<td class="text-end text-primary"><strong>' + fmtC(totExp)    + '</strong></td>' +
            '<td class="text-end ' + utilClass(totalUtilPct) + '"><strong>' + totalUtilPct + '%</strong></td>' +
            '<td class="text-end"><strong>' + fmtC(totBalance)   + '</strong></td>' +
            '</tr>'
        );

        objDT = $('#objTable').DataTable({
            pageLength: 10,
            order: [[2, 'desc']],
            scrollX: true,
            dom: '<"d-flex justify-content-between align-items-center mb-2"lf>rtip',
            language: { emptyTable: 'No data found', zeroRecords: 'No matching records' }
        });
    }

    function updateSummary(data) {
        if (!data.length) { $('#summaryBar').hide(); return; }
        const a = data.reduce((s, r) => ({
            al: s.al + r.totalAllocatedBudget,
            bg: s.bg + r.totalBudgetGrant,
            rl: s.rl + r.totalReleases,
            ex: s.ex + r.totalActualExpenditure,
            bl: s.bl + r.totalBalance
        }), { al: 0, bg: 0, rl: 0, ex: 0, bl: 0 });
        $('#sumAllocated').text(fmtC(a.al));
        $('#sumBudgetGrant').text(fmtC(a.bg));
        $('#sumReleases').text(fmtC(a.rl));
        $('#sumExpenditure').text(fmtC(a.ex));
        $('#sumBalance').text(fmtC(a.bl));
        $('#summaryBar').css('display', '');
    }

    function updatePrintSubtitle(year, sector, dept, fund, cc, obj) {
        const yearLbl   = year   || 'All Years';
        const sectorLbl = $('#filterSector').find('option:selected').text() || 'All Sectors';
        const deptLbl   = $('#filterDept').find('option:selected').text()   || 'All Departments';
        const fundLbl   = $('#filterFund').find('option:selected').text()   || 'All Funds';
        const ccLbl     = $('#filterCC').find('option:selected').text()     || 'All Cost Centers';
        const objLbl    = obj ? ($('#filterObj').find('option:selected').text() || obj) : 'All Objects';
        $('#printSubtitle').text('Year: ' + yearLbl + ' | Sector: ' + sectorLbl + ' | Dept: ' + deptLbl +
            ' | Fund: ' + fundLbl + ' | CC: ' + ccLbl + ' | Object: ' + objLbl);
    }

    function exportPdfReport() {
        const year    = $('#filterYear').val()   || null;
        const sector  = $('#filterSector').val() || null;
        const dept    = $('#filterDept').val()   || null;
        const fund    = $('#filterFund').val()   || null;
        const cc      = $('#filterCC').val()     || null;
        const obj     = $('#filterObj').val()    || null;

        ajaxGet('/Reports/GetObjectWiseGroupedData',
            { financialYear: year, sector: sector, departmentCode: dept, fundCode: fund, costCenterCode: cc, keyword: obj },
            function (r) {
                if (!r.success || !r.data.length) { showToast('error', 'No data to export.'); return; }
                buildObjectPdf(r.data, year, sector, dept, fund, cc, obj);
            },
            function () { showToast('error', 'Failed to load grouped data for PDF.'); });
    }

    function buildObjectPdf(rows, year, sector, dept, fund, cc, obj) {
        const { jsPDF } = window.jspdf;
        const doc   = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a3' });
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const cx    = pageW / 2;
        const _d    = new Date();
        const _mon  = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const today = String(_d.getDate()).padStart(2,'0') + ' ' + _mon[_d.getMonth()] + ' ' + _d.getFullYear();

        const yearLbl   = year   || 'All Years';
        const sectorLbl = sector ? ($('#filterSector').find('option:selected').text() || sector) : 'All Sectors';
        const deptLbl   = dept   ? ($('#filterDept').find('option:selected').text()   || dept)   : 'All Departments';
        const fundLbl   = fund   ? ($('#filterFund').find('option:selected').text()   || fund)   : 'All Funds';
        const ccLbl     = cc     ? ($('#filterCC').find('option:selected').text()     || cc)     : 'All Cost Centers';
        const objLbl    = obj    ? ($('#filterObj').find('option:selected').text()    || obj)    : 'All Objects';

        // colours
        const C_NAVY    = [11, 43, 82];
        const C_SECTOR  = [0, 70, 127];
        const C_DEPT    = [14, 99, 160];
        const C_FUND    = [41, 128, 185];
        const C_SUBTOT  = [214, 229, 247];
        const C_ALTROW  = [248, 250, 255];
        const C_WHITE   = [255, 255, 255];
        const C_DARK    = [25, 25, 25];

        const COLS = [70, 210, 85, 85, 80, 52, 85, 52, 80];
        const L_MARGIN = 8, R_MARGIN = 8;
        const tableW = pageW - L_MARGIN - R_MARGIN;

        function drawPageHeader(pgDoc, isFirst) {
            pgDoc.setFillColor(...C_NAVY);
            pgDoc.rect(0, 0, pageW, isFirst ? 62 : 28, 'F');
            pgDoc.setFont('helvetica', 'bold');
            pgDoc.setFontSize(isFirst ? 20 : 11);
            pgDoc.setTextColor(...C_WHITE);
            pgDoc.text('OBJECT WISE BUDGET REPORT' + (isFirst ? '' : '  (contd.)'), cx, isFirst ? 24 : 18, { align: 'center' });
            if (isFirst) {
                pgDoc.setFontSize(8.5); pgDoc.setFont('helvetica', 'normal');
                pgDoc.setTextColor(210, 220, 245);
                pgDoc.text('Year: ' + yearLbl + '   |   Sector: ' + sectorLbl + '   |   Dept: ' + deptLbl + '   |   Fund: ' + fundLbl, cx, 40, { align: 'center' });
                pgDoc.text('Cost Center: ' + ccLbl + '   |   Object Code: ' + objLbl + '   |   Generated: ' + today, cx, 52, { align: 'center' });
            }
        }

        function drawPageFooter(pgDoc) {
            const pc  = pgDoc.internal.getNumberOfPages();
            const cur = pgDoc.internal.getCurrentPageInfo().pageNumber;
            pgDoc.setFillColor(...C_NAVY);
            pgDoc.rect(0, pageH - 22, pageW, 22, 'F');
            pgDoc.setFont('helvetica', 'normal'); pgDoc.setFontSize(8);
            pgDoc.setTextColor(245, 248, 252);
            pgDoc.text('Object Wise Budget Report   |   ' + yearLbl + '   |   Page ' + cur + ' of ' + pc, cx, pageH - 9, { align: 'center' });
        }

        // column header row
        const HEAD = [
            { content: 'OBJECT\nCODE',   styles: { halign: 'left'   } },
            { content: 'DESCRIPTION',    styles: { halign: 'left'   } },
            { content: 'ALLOC\nBUDGET',  styles: { halign: 'right'  } },
            { content: 'BUDGET\nGRANT',  styles: { halign: 'right'  } },
            { content: 'RELEASES',       styles: { halign: 'right'  } },
            { content: '% REL',          styles: { halign: 'center' } },
            { content: 'EXPENDITURE',    styles: { halign: 'right'  } },
            { content: '% UTIL',         styles: { halign: 'center' } },
            { content: 'BALANCE',        styles: { halign: 'right'  } }
        ];

        function fmtN(v) { return Math.round(parseFloat(v) || 0).toLocaleString('en-PK'); }
        function pct(a, b) { return b > 0 ? (a / b * 100).toFixed(1) + '%' : '0.0%'; }
        function subtotRow(label, item, fillColor, fontColor) {
            return {
                cells: [
                    { content: label, colSpan: 2, styles: { halign: 'left', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: fmtN(item.al), styles: { halign: 'right', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: fmtN(item.bg), styles: { halign: 'right', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: fmtN(item.rl), styles: { halign: 'right', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: pct(item.rl, item.al), styles: { halign: 'center', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: fmtN(item.ex), styles: { halign: 'right', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: pct(item.ex, item.fg), styles: { halign: 'center', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } },
                    { content: fmtN(item.bl), styles: { halign: 'right', fontStyle: 'bold', fillColor: fillColor, textColor: fontColor } }
                ]
            };
        }

        // Build body
        const body = [];
        const rowStyles = {};

        // accumulate from a raw API row (long property names) into a totals object
        function acc(t, r) {
            t.al += r.totalAllocatedBudget; t.bg += r.totalBudgetGrant;
            t.rl += r.totalReleases; t.fg += r.totalFinalGrant;
            t.ex += r.totalActualExpenditure; t.bl += r.totalBalance;
        }
        // roll up from one totals object (short names) into another
        function roll(dest, src) {
            dest.al += src.al; dest.bg += src.bg;
            dest.rl += src.rl; dest.fg += src.fg;
            dest.ex += src.ex; dest.bl += src.bl;
        }
        function zero() { return { al:0, bg:0, rl:0, fg:0, ex:0, bl:0 }; }

        const grand = zero();
        // group by sector
        const secMap = {};
        rows.forEach(function (r) {
            (secMap[r.sector] = secMap[r.sector] || {})[r.department] = secMap[r.sector][r.department] || {};
            const dMap = secMap[r.sector][r.department];
            const fKey = r.fundCode;
            (dMap[fKey] = dMap[fKey] || { desc: r.fundDescription, items: [] }).items.push(r);
        });

        Object.keys(secMap).sort().forEach(function (sec) {
            const sTotal = zero();
            // Sector heading row
            const sIdx = body.length;
            body.push([{ content: 'SECTOR:  ' + sec, colSpan: 9, styles: { halign: 'left', fontStyle: 'bold', fillColor: C_SECTOR, textColor: C_WHITE, fontSize: 9 } }]);
            rowStyles[sIdx] = { minCellHeight: 18 };

            const dMap = secMap[sec];
            Object.keys(dMap).sort().forEach(function (dep) {
                const dTotal = zero();
                const dIdx = body.length;
                body.push([{ content: '  Department:  ' + dep, colSpan: 9, styles: { halign: 'left', fontStyle: 'bold', fillColor: C_DEPT, textColor: C_WHITE, fontSize: 8.5 } }]);
                rowStyles[dIdx] = { minCellHeight: 16 };

                const fObj = dMap[dep];
                Object.keys(fObj).sort().forEach(function (fc) {
                    const fTotal = zero();
                    const fIdx = body.length;
                    const fDesc = fObj[fc].desc || '';
                    body.push([{ content: '    Fund:  ' + fc + (fDesc ? '  ' + fDesc : ''), colSpan: 9, styles: { halign: 'left', fontStyle: 'normal', fillColor: C_FUND, textColor: C_WHITE, fontSize: 8 } }]);
                    rowStyles[fIdx] = { minCellHeight: 15 };

                    fObj[fc].items.forEach(function (item, altIdx) {
                        const fillColor = altIdx % 2 === 0 ? C_WHITE : C_ALTROW;
                        const relPct = pct(item.totalReleases, item.totalAllocatedBudget);
                        const utilPct = pct(item.totalActualExpenditure, item.totalFinalGrant);
                        body.push([
                            { content: item.detailObject,            styles: { halign: 'left',   fillColor: fillColor, textColor: C_DARK } },
                            { content: item.objectDescription || '—', styles: { halign: 'left',   fillColor: fillColor, textColor: C_DARK } },
                            { content: fmtN(item.totalAllocatedBudget),    styles: { halign: 'right',  fillColor: fillColor, textColor: C_DARK } },
                            { content: fmtN(item.totalBudgetGrant),        styles: { halign: 'right',  fillColor: fillColor, textColor: C_DARK } },
                            { content: fmtN(item.totalReleases),           styles: { halign: 'right',  fillColor: fillColor, textColor: C_DARK } },
                            { content: relPct,                             styles: { halign: 'center', fillColor: fillColor, textColor: C_DARK } },
                            { content: fmtN(item.totalActualExpenditure),  styles: { halign: 'right',  fillColor: fillColor, textColor: C_DARK } },
                            { content: utilPct,                            styles: { halign: 'center', fillColor: fillColor, textColor: C_DARK } },
                            { content: fmtN(item.totalBalance),            styles: { halign: 'right',  fillColor: fillColor, textColor: C_DARK } }
                        ]);
                        acc(fTotal, { totalAllocatedBudget: item.totalAllocatedBudget, totalBudgetGrant: item.totalBudgetGrant, totalReleases: item.totalReleases, totalFinalGrant: item.totalFinalGrant, totalActualExpenditure: item.totalActualExpenditure, totalBalance: item.totalBalance });
                    });
                    // Fund subtotal
                    body.push(subtotRow('    Subtotal — Fund: ' + fc, fTotal, C_SUBTOT, C_DARK).cells);
                    roll(dTotal, fTotal); roll(sTotal, fTotal); roll(grand, fTotal);
                });
                // Dept subtotal
                body.push(subtotRow('  Subtotal — Dept: ' + dep, dTotal, [185, 210, 240], C_DARK).cells);
            });
            // Sector subtotal
            body.push(subtotRow('Subtotal — Sector: ' + sec, sTotal, [155, 190, 230], C_DARK).cells);
        });

        // Grand total
        body.push(subtotRow('GRAND TOTAL', grand, C_NAVY, C_WHITE).cells);

        // Draw the first page header before autoTable
        drawPageHeader(doc, true);

        doc.autoTable({
            head: [HEAD],
            body: body,
            startY: 68,
            margin: { left: L_MARGIN, right: R_MARGIN, bottom: 28 },
            tableWidth: tableW,
            styles: {
                fontSize: 7.5,
                cellPadding: { top: 5, bottom: 5, left: 4, right: 4 },
                valign: 'middle',
                lineColor: [220, 225, 235],
                lineWidth: 0.3,
                textColor: C_DARK
            },
            headStyles: {
                fillColor: C_NAVY,
                textColor: C_WHITE,
                fontStyle: 'bold',
                fontSize: 8,
                halign: 'center',
                valign: 'middle',
                minCellHeight: 30,
                lineWidth: 0
            },
            columnStyles: {
                0: { cellWidth: COLS[0] },
                1: { cellWidth: COLS[1] },
                2: { cellWidth: COLS[2] },
                3: { cellWidth: COLS[3] },
                4: { cellWidth: COLS[4] },
                5: { cellWidth: COLS[5] },
                6: { cellWidth: COLS[6] },
                7: { cellWidth: COLS[7] },
                8: { cellWidth: COLS[8] }
            },
            didDrawPage: function (data) {
                if (data.pageNumber > 1) drawPageHeader(doc, false);
                drawPageFooter(doc);
            }
        });

        doc.save('ObjectWise_' + yearLbl.replace(/\//g, '-') + '_' + today.replace(/\s/g, '-') + '.pdf');
    }

    function exportExcel() {
        const year   = $('#filterYear').val()   || null;
        const sector = $('#filterSector').val() || null;
        const dept   = $('#filterDept').val()   || null;
        const fund   = $('#filterFund').val()   || null;
        const cc     = $('#filterCC').val()     || null;
        const obj    = $('#filterObj').val()    || null;
        exportToExcel('/Reports/ExportExcel?reportType=object', { financialYear: year, sector: sector, departmentCode: dept, fundCode: fund, costCenterCode: cc, keyword: obj });
    }

    function clearFilters() {
        $('#filterYear').val('');
        if ($('#filterSector').hasClass('select2-hidden-accessible')) $('#filterSector').val('').trigger('change.select2');
        if ($('#filterDept').hasClass('select2-hidden-accessible'))   $('#filterDept').val('').trigger('change.select2');
        if ($('#filterFund').hasClass('select2-hidden-accessible'))   $('#filterFund').val('').trigger('change.select2');
        if ($('#filterCC').hasClass('select2-hidden-accessible'))     $('#filterCC').val('').trigger('change.select2');
        resetObjDropdown();
        loadSectorDropdown(null);
        loadDeptDropdown(null, null);
        loadFundDropdown(null, null, null);
        loadCCDropdown(null, null);
        loadData();
    }

    function utilClass(pct) {
        const v = parseFloat(pct);
        if (v >= 90) return 'pct-danger';
        if (v >= 70) return 'pct-warning';
        return 'pct-ok';
    }
    function fmtC(v) {
        const n = Math.round(parseFloat(v) || 0);
        return n.toLocaleString('en-PK');
    }
    function esc(s) {
        if (!s) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
}
