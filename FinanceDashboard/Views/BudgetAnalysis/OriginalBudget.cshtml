@{
    ViewData["Title"] = "Original Budget";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title"><i class="bi bi-file-earmark-text me-2"></i>Original Budget</h2>
            <p class="text-muted mb-0">View and analyze original budget data</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-success btn-sm" onclick="exportExcel()">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportPdf()">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="printPage()">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <div class="filter-form">
            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <select id="filterYear" class="form-select form-select-sm select2">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fund</label>
                <select id="filterFund" class="form-select form-select-sm select2">
                    <option value="">All Funds</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Department</label>
                <select id="filterDept" class="form-select form-select-sm select2">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Keyword</label>
                <input type="text" id="filterKeyword" class="form-control form-control-sm" placeholder="Search..." />
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary btn-sm" onclick="applyFilters()">
                    <i class="bi bi-search"></i>
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-container">
        <table id="originalBudgetTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Year</th>
                    <th>Document</th>
                    <th>Department</th>
                    <th>Fund</th>
                    <th>Cost Center</th>
                    <th>Commitment Item</th>
                    <th>Posts</th>
                    <th>Original Amount</th>
                    <th>Revised Amount</th>
                    <th>Designation</th>
                    <th>Function</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let obTable;

        $(document).ready(function () {
            loadFilters();
            initTable();
        });

        function loadFilters() {
            // Load financial years
            ajaxGet('/Dashboard/GetFinancialYears', {}, function (r) {
                if (r.success) {
                    const sel = $('#filterYear');
                    r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
                }
            });

            // Load funds
            ajaxGet('/Dashboard/GetLookups', { type: 'Fund' }, function (r) {
                if (r.success) {
                    const sel = $('#filterFund');
                    r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
                }
            });

            // Load departments
            ajaxGet('/Dashboard/GetLookups', { type: 'Department' }, function (r) {
                if (r.success) {
                    const sel = $('#filterDept');
                    r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
                }
            });
        }

        function initTable() {
            obTable = $('#originalBudgetTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/BudgetAnalysis/GetOriginalBudgetData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        return JSON.stringify({
                            draw: d.draw,
                            start: d.start,
                            length: d.length,
                            searchValue: d.search?.value || '',
                            sortColumn: d.columns?.[d.order?.[0]?.column]?.data || 'Id',
                            sortDirection: d.order?.[0]?.dir || 'asc',
                            financialYear: $('#filterYear').val() || null,
                            fundCode: $('#filterFund').val() || null,
                            departmentCode: $('#filterDept').val() || null,
                            keyword: $('#filterKeyword').val() || null
                        });
                    },
                    dataSrc: 'data',
                    beforeSend: showLoading,
                    complete: hideLoading
                },
                columns: [
                    { data: 'id', width: '60px' },
                    { data: 'financialYear', width: '60px' },
                    { data: 'documentNumber', width: '120px' },
                    { data: 'departmentCode', width: '80px' },
                    { data: 'fundCode', width: '100px' },
                    { data: 'costCenterCode', width: '100px' },
                    { data: 'commitmentItem', width: '100px' },
                    { data: 'posts', width: '50px', render: function (d) { return formatNumber(d); } },
                    { data: 'originalBudgetAmount', width: '120px', render: function (d) { return formatCurrency(d); } },
                    { data: 'revisedBudgetAmount', width: '120px', render: function (d) { return formatCurrency(d); } },
                    { data: 'designationDescription', width: '150px' },
                    { data: 'functionCode', width: '80px' }
                ],
                pageLength: 50,
                order: [[0, 'desc']]
            });
        }

        function applyFilters() {
            obTable.ajax.reload();
        }

        function clearFilters() {
            $('#filterYear, #filterFund, #filterDept').val('').trigger('change');
            $('#filterKeyword').val('');
            obTable.ajax.reload();
        }

        function exportExcel() {
            const params = {
                financialYear: $('#filterYear').val() || null,
                fundCode: $('#filterFund').val() || null,
                departmentCode: $('#filterDept').val() || null,
                keyword: $('#filterKeyword').val() || null
            };
            exportToExcel('/BudgetAnalysis/ExportOriginalBudgetExcel', params);
        }

        function exportPdf() {
            const params = {
                financialYear: $('#filterYear').val() || null,
                fundCode: $('#filterFund').val() || null,
                departmentCode: $('#filterDept').val() || null,
                keyword: $('#filterKeyword').val() || null
            };
            exportToPdf('/BudgetAnalysis/ExportOriginalBudgetPdf', params);
        }
    </script>
}
