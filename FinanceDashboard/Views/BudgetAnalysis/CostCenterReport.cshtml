@{
    ViewData["Title"] = "Cost Center Report";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title"><i class="bi bi-building me-2"></i>Cost Center Report</h2>
            <p class="text-muted mb-0">Original budget grouped by cost center and commitment item</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline-success btn-sm" onclick="exportExcel()">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </button>
            <button class="btn btn-outline-danger btn-sm" onclick="exportPdf()">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </button>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-bar">
        <div class="filter-form">
            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <select id="filterYear" class="form-select form-select-sm select2">
                    <option value="">All Years</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Fund</label>
                <select id="filterFund" class="form-select form-select-sm select2">
                    <option value="">All Funds</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Cost Center</label>
                <select id="filterCostCenter" class="form-select form-select-sm select2">
                    <option value="">All Cost Centers</option>
                </select>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary btn-sm" onclick="loadReport()">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()" title="Clear filters">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card bg-primary">
                <div class="stat-icon"><i class="bi bi-building"></i></div>
                <div class="stat-value" id="totalCostCenters">0</div>
                <div class="stat-label">Cost Centers</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-success">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-value" id="summaryOriginalBudget">PKR 0</div>
                <div class="stat-label">Total Original Budget</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-info">
                <div class="stat-icon"><i class="bi bi-pencil-square"></i></div>
                <div class="stat-value" id="summaryRevisedBudget">PKR 0</div>
                <div class="stat-label">Total Revised Budget</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card bg-warning" id="varianceCard">
                <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
                <div class="stat-value" id="summaryVariance">PKR 0</div>
                <div class="stat-label">Total Variance</div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-container">
        <table id="costCenterReportTable" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Year</th>
                    <th>Department</th>
                    <th>Fund Code</th>
                    <th>Cost Center</th>
                    <th>Commitment Item</th>
                    <th class="text-end">Posts</th>
                    <th class="text-end">Original Budget (PKR)</th>
                    <th class="text-end">Revised Budget (PKR)</th>
                    <th class="text-end">Variance (PKR)</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr class="fw-bold table-primary">
                    <td colspan="6" class="text-end">Grand Total</td>
                    <td class="text-end" id="footerOriginal">—</td>
                    <td class="text-end" id="footerRevised">—</td>
                    <td class="text-end" id="footerVariance">—</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let reportTable;
        let allData = [];
        let ccXhr = null; // track in-flight cost-center request so we can abort on rapid changes

        $(document).ready(function () {
            initTable();
            // Load Years and Funds in parallel — do NOT auto-load the report
            $.when(fetchYears(), fetchFunds()).done(function () {
                refreshCostCenterDropdown(false); // populate cost-center dropdown only, no report
            });
        });

        /* ── Lightweight helpers that do NOT show the global overlay ─────── */
        function fetchYears() {
            return $.getJSON('/Dashboard/GetFinancialYears').done(function (r) {
                if (r.success && r.data) {
                    const sel = $('#filterYear');
                    r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
                }
            });
        }

        function fetchFunds() {
            return $.getJSON('/Dashboard/GetLookups', { type: 'Fund' }).done(function (r) {
                if (r.success && r.data) {
                    const sel = $('#filterFund');
                    r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
                }
            });
        }

        /* ── Repopulate Cost-Center dropdown (no query, no overlay) ─────── */
        function refreshCostCenterDropdown(thenSearch) {
            const year = $('#filterYear').val() || null;
            const fund = $('#filterFund').val() || null;

            if (ccXhr) { ccXhr.abort(); }

            $('#filterCostCenter').html('<option value="">All Cost Centers</option>');

            ccXhr = $.getJSON('/BudgetAnalysis/GetCostCenters', { financialYear: year, fundCode: fund })
                .done(function (r) {
                    if (r.success && r.data && r.data.length > 0) {
                        const sel = $('#filterCostCenter');
                        r.data.forEach(i => sel.append('<option value="' + i.value + '">' + i.text + '</option>'));
                    }
                    if (thenSearch) { loadReport(); }
                });
        }

        function initTable() {
            reportTable = $('#costCenterReportTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                lengthChange: true,
                pageLength: 50,
                lengthMenu: [[25, 50, 100, -1], [25, 50, 100, 'All']],
                columns: [
                    { data: 'financialYear' },
                    { data: 'departmentCode' },
                    { data: 'fundCode' },
                    { data: 'costCenterCode' },
                    { data: 'commitmentItem' },
                    {
                        data: 'posts',
                        className: 'text-end',
                        render: function (data) { return formatNumber(data || 0); }
                    },
                    {
                        data: 'originalBudgetAmount',
                        className: 'text-end',
                        render: function (data) { return formatCurrency(data || 0); }
                    },
                    {
                        data: 'revisedBudgetAmount',
                        className: 'text-end',
                        render: function (data) { return formatCurrency(data || 0); }
                    },
                    {
                        data: 'variance',
                        className: 'text-end',
                        render: function (data) {
                            const cls = data > 0 ? 'text-success' : (data < 0 ? 'text-danger' : '');
                            return '<span class="' + cls + '">' + formatCurrency(data || 0) + '</span>';
                        }
                    }
                ],
                order: [[0, 'desc'], [3, 'asc']],
                language: {
                    emptyTable: 'Select filters and click <strong>Search</strong> to load data.',
                    zeroRecords: 'No matching records found.'
                },
                drawCallback: function () {
                    updateFooterTotals();
                }
            });

            // Year / Fund change → refresh cost-center list only, do NOT auto-search
            $('#filterYear, #filterFund').on('change', function () {
                refreshCostCenterDropdown(false);
            });

            // Cost-center change → do NOT auto-search; user must click Search
        }

        /* ── Main search — only called by the Search button ─────────────── */
        function loadReport() {
            if (!reportTable) return;

            const year = $('#filterYear').val() || null;
            if (!year) {
                showToast('warning', 'Please select a Financial Year before searching.');
                return;
            }

            showLoading();
            const filters = {
                financialYear: year,
                fundCode: $('#filterFund').val() || null,
                costCenterCode: $('#filterCostCenter').val() || null
            };

            $.ajax({
                url: '/BudgetAnalysis/GetCostCenterReportData',
                type: 'GET',
                data: filters,
                success: function (r) {
                    hideLoading();
                    if (r.success) {
                        allData = r.data || [];
                        reportTable.clear().rows.add(allData).draw();
                        updateSummaryCards(allData);
                    } else {
                        showToast('error', r.message || 'Failed to load report');
                        allData = [];
                        reportTable.clear().draw();
                        updateSummaryCards([]);
                    }
                },
                error: function (xhr) {
                    hideLoading();
                    if (xhr.statusText !== 'abort') {
                        showToast('error', 'Error loading Cost Center Report. Please try again.');
                    }
                    allData = [];
                    reportTable.clear().draw();
                    updateSummaryCards([]);
                }
            });
        }

        function updateSummaryCards(data) {
            const uniqueCostCenters = new Set(data.map(r => r.costCenterCode)).size;
            const totalOriginal = data.reduce((s, r) => s + (r.originalBudgetAmount || 0), 0);
            const totalRevised = data.reduce((s, r) => s + (r.revisedBudgetAmount || 0), 0);
            const totalVariance = totalRevised - totalOriginal;

            $('#totalCostCenters').text(formatNumber(uniqueCostCenters));
            $('#summaryOriginalBudget').text(formatCurrency(totalOriginal));
            $('#summaryRevisedBudget').text(formatCurrency(totalRevised));
            $('#summaryVariance').text(formatCurrency(totalVariance));

            const card = $('#varianceCard');
            card.removeClass('bg-warning bg-success bg-danger');
            card.addClass(totalVariance > 0 ? 'bg-success' : (totalVariance < 0 ? 'bg-danger' : 'bg-warning'));
        }

        function updateFooterTotals() {
            if (!allData || allData.length === 0) {
                $('#footerOriginal, #footerRevised, #footerVariance').text('—');
                return;
            }
            const totalOriginal = allData.reduce((s, r) => s + (r.originalBudgetAmount || 0), 0);
            const totalRevised = allData.reduce((s, r) => s + (r.revisedBudgetAmount || 0), 0);
            const totalVariance = totalRevised - totalOriginal;
            $('#footerOriginal').text(formatCurrency(totalOriginal));
            $('#footerRevised').text(formatCurrency(totalRevised));
            const varStr = formatCurrency(totalVariance);
            $('#footerVariance').html(totalVariance < 0
                ? '<span class="text-danger">' + varStr + '</span>'
                : '<span class="text-success">' + varStr + '</span>');
        }

        function clearFilters() {
            $('#filterYear').val('');
            $('#filterFund').val('');
            $('#filterCostCenter').html('<option value="">All Cost Centers</option>');
            allData = [];
            reportTable.clear().draw();
            updateSummaryCards([]);
        }

        function exportExcel() {
            const year = $('#filterYear').val();
            if (!year) { showToast('warning', 'Please select a Financial Year first.'); return; }
            const params = new URLSearchParams();
            params.append('financialYear', year);
            const fund = $('#filterFund').val();
            const cc = $('#filterCostCenter').val();
            if (fund) params.append('fundCode', fund);
            if (cc) params.append('costCenterCode', cc);
            window.location.href = '/BudgetAnalysis/ExportCostCenterReportExcel?' + params.toString();
        }

        function exportPdf() {
            const year = $('#filterYear').val();
            if (!year) { showToast('warning', 'Please select a Financial Year first.'); return; }
            const params = new URLSearchParams();
            params.append('financialYear', year);
            const fund = $('#filterFund').val();
            const cc = $('#filterCostCenter').val();
            if (fund) params.append('fundCode', fund);
            if (cc) params.append('costCenterCode', cc);
            window.location.href = '/BudgetAnalysis/ExportCostCenterReportPdf?' + params.toString();
        }
    </script>
}
