@model List<FinanceDashboard.Models.ApplicationUser>

@{
    ViewData["Title"] = "Users";
}

<div class="fade-in">
    <div class="page-header">
        <div>
            <h2 class="page-title"><i class="bi bi-people me-2"></i>Users</h2>
            <p class="text-muted mb-0">Manage system users</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#userModal" onclick="resetForm()">
                <i class="bi bi-plus-circle me-1"></i>Add User
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="usersTable">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Full Name</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr id="user-row-@user.Id">
                                <td>@user.Email</td>
                                <td>@user.FullName</td>
                                <td>@user.Department</td>
                                <td>@user.Designation</td>
                                <td><span class="badge bg-primary">@(ViewBag.UserRoles is Dictionary<string, string> roles && roles.TryGetValue(user.Id, out var roleName) ? roleName : "User")</span></td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@(user.LastLoginDate?.ToString("dd-MMM-yyyy HH:mm") ?? "Never")</td>
                                <td>@user.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    <button class="btn btn-outline-primary btn-sm" onclick="editUser('@user.Id')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" onclick="deleteUser('@user.Id')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userModalTitle">Add User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="userForm">
                    <input type="hidden" id="userId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" id="userEmail" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3" id="passwordField">
                            <label class="form-label">Password</label>
                            <input type="password" id="userPassword" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" id="userFullName" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Role(s)</label>
                            <div class="border rounded p-2" id="userRoleGroup" onchange="onRoleChange()">
                                <div class="form-check">
                                    <input class="form-check-input role-check" type="checkbox" value="EndUser" id="role_EndUser">
                                    <label class="form-check-label" for="role_EndUser">End User</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input role-check" type="checkbox" value="DepartmentUser" id="role_DepartmentUser">
                                    <label class="form-check-label" for="role_DepartmentUser">Department User</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input role-check" type="checkbox" value="SNEDepartmentUser" id="role_SNEDepartmentUser">
                                    <label class="form-check-label" for="role_SNEDepartmentUser">SNE Department User</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input role-check" type="checkbox" value="Administrator" id="role_Administrator">
                                    <label class="form-check-label" for="role_Administrator">Administrator</label>
                                </div>
                            </div>
                            <div class="form-text">Select both Department User and SNE Department User to create a "Budget Officer" who accesses their department dashboard plus the Permanent Budget dashboard for the assigned departments.</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department(s)</label>
                            <select id="userDepartment" class="form-select" multiple size="5">
                            </select>
                            <div class="form-text">Required for Department User / SNE Department User roles — restricts this user to only the selected department(s)' data. A user with both Department User and SNE Department User roles (Budget Officer) may select multiple departments and will see the Permanent Budget dashboard for only those departments. Hold Ctrl/Cmd to select multiple.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Designation</label>
                            <input type="text" id="userDesignation" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" id="userIsActive" class="form-check-input" checked />
                        <label class="form-check-label">Active</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveUser()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({ pageLength: 25, order: [[7, 'desc']] });
            loadDepartmentOptions();
        });

        function loadDepartmentOptions() {
            ajaxGet('/Dashboard/GetDepartmentLookup', {}, function (r) {
                if (r.success) {
                    const sel = $('#userDepartment');
                    sel.empty();
                    r.data.forEach(function (item) {
                        sel.append(`<option value="${item.value}">${item.text}</option>`);
                    });
                }
            });
        }

        function getSelectedRoles() {
            return $('.role-check:checked').map(function () { return $(this).val(); }).get();
        }

        function setSelectedRoles(roles) {
            $('.role-check').prop('checked', false);
            (roles || []).forEach(function (role) {
                $('#role_' + role).prop('checked', true);
            });
        }

        function onRoleChange() {
            const roles = getSelectedRoles();
            const needsDepartment = roles.includes('DepartmentUser') || roles.includes('SNEDepartmentUser');
            $('#userDepartment').prop('required', needsDepartment);
        }

        let isEditing = false;

        function resetForm() {
            isEditing = false;
            $('#userModalTitle').text('Add User');
            $('#userForm')[0].reset();
            $('#userId').val('');
            $('#passwordField').show();
            $('#userPassword').prop('required', true);
            setSelectedRoles([]);
            onRoleChange();
        }

        function editUser(id) {
            isEditing = true;
            $('#userModalTitle').text('Edit User');
            $('#passwordField').hide();
            $('#userPassword').prop('required', false);

            showLoading();
            ajaxGet('/Administration/GetUser', { id: id }, function (r) {
                hideLoading();
                if (r.success) {
                    const u = r.data.user;
                    $('#userId').val(u.id);
                    $('#userEmail').val(u.email);
                    $('#userFullName').val(u.fullName);
                    $('#userDepartment').val(u.department ? u.department.split(',').map(d => d.trim()) : []);
                    $('#userDesignation').val(u.designation);
                    $('#userIsActive').prop('checked', u.isActive);
                    setSelectedRoles(r.data.roles);
                    onRoleChange();
                    $('#userModal').modal('show');
                }
            });
        }

        function saveUser() {
            const selectedDepartments = $('#userDepartment').val() || [];
            const selectedRoles = getSelectedRoles();
            const data = {
                Email: $('#userEmail').val(),
                FullName: $('#userFullName').val(),
                Department: selectedDepartments.join(','),
                Designation: $('#userDesignation').val(),
                IsActive: $('#userIsActive').is(':checked'),
                Roles: selectedRoles
            };

            if (selectedRoles.length === 0) {
                showToast('error', 'Please select at least one role.');
                return;
            }

            const isDepartmentUser = selectedRoles.includes('DepartmentUser');
            const isSneUser = selectedRoles.includes('SNEDepartmentUser');

            if ((isDepartmentUser || isSneUser) && selectedDepartments.length === 0) {
                showToast('error', 'Please select at least one Department for a Department User / SNE Department User.');
                return;
            }

            if (!isEditing) {
                data.Password = $('#userPassword').val();
                if (!data.Password) { showToast('error', 'Password is required.'); return; }
            }

            const url = isEditing ? '/Administration/UpdateUser' : '/Administration/CreateUser';
            if (isEditing) data.Id = $('#userId').val();

            showLoading();
            ajaxPostJson(url, data, function (r) {
                hideLoading();
                if (r.success) {
                    showToast('success', r.message);
                    $('#userModal').modal('hide');
                    setTimeout(() => location.reload(), 500);
                } else {
                    showToast('error', r.message);
                }
            });
        }

        function deleteUser(id) {
            confirmAction('Delete this user?', function () {
                showLoading();
                ajaxPost('/Administration/DeleteUser', { id: id }, function (r) {
                    hideLoading();
                    if (r.success) {
                        showToast('success', r.message);
                        $('#user-row-' + id).fadeOut(300, function () { $(this).remove(); });
                    } else {
                        showToast('error', r.message);
                    }
                });
            });
        }
    </script>
}
