@{
    ViewData["Title"] = "Error";
}

<div class="text-center fade-in" style="padding-top: 100px;">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
    <h2 class="mt-4">An Error Occurred</h2>
    <p class="text-muted">Something went wrong while processing your request.</p>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>
