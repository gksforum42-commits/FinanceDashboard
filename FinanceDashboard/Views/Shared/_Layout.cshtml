<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <base href="~/" />
    <title>@ViewData["Title"] - Finance Dashboard</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet">
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/dashboard.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Loading Spinner -->
    <div id="loading-overlay" class="loading-overlay d-none">
        <div class="spinner-container">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-primary">Loading...</p>
        </div>
    </div>

    <!-- Toast Notifications -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        <div id="toast-success" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="toast-success-msg">Operation completed successfully.</span></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        <div id="toast-error" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-exclamation-circle me-2"></i><span id="toast-error-msg">An error occurred.</span></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        <div id="toast-warning" class="toast align-items-center text-bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body text-dark"><i class="bi bi-exclamation-triangle me-2"></i><span id="toast-warning-msg">Warning message.</span></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
        <div id="toast-info" class="toast align-items-center text-bg-primary border-0" role="alert" aria-live="polite" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-info-circle me-2"></i><span id="toast-info-msg">Information.</span></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Sidebar -->
            <nav id="sidebar" class="sidebar">
                <div class="sidebar-header">
                    <div class="d-flex align-items-center justify-content-center py-3">
                        <i class="bi bi-bank2 fs-2 me-2"></i>
                        <div>
                            <h5 class="mb-0">Finance Dept</h5>
                            <small class="text-muted">Punjab Government</small>
                        </div>
                    </div>
                </div>

                <div class="sidebar-user">
                    <div class="d-flex align-items-center px-3 py-2">
                        <div class="user-avatar">
                            <i class="bi bi-person-circle fs-3"></i>
                        </div>
                        <div class="ms-2 user-info">
                            <small class="d-block fw-semibold text-truncate" style="max-width: 160px;">@User.Identity?.Name</small>
                            <small class="text-muted">
                                @if (User.IsInRole("Administrator"))
                                {
                                    <span><i class="bi bi-shield-check me-1"></i>Administrator</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-person me-1"></i>End User</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>

                <ul class="list-unstyled components">
                    @if (User.IsInRole("SNEDepartmentUser") && !User.IsInRole("Administrator") && !User.IsInRole("DepartmentUser"))
                    {
                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sne" ? "active" : "")">
                            <a class="nav-link" asp-controller="Sne" asp-action="Index">
                                <i class="bi bi-file-earmark-spreadsheet"></i>
                                <span>Permanent Budget</span>
                            </a>
                        </li>
                    }
                    else
                    {
                    <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="nav-section-title">Budget Reports</li>
                    <li class="nav-item">
                        <a class="nav-link" href="#berAnalysisSubmenu" data-bs-toggle="collapse" role="button" aria-expanded="true" aria-controls="berAnalysisSubmenu" id="berAnalysisToggle">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Budget Reports</span>
                            <i class="bi bi-chevron-down ms-auto small"></i>
                        </a>
                        <ul class="collapse list-unstyled show" id="berAnalysisSubmenu">
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "DepartmentWise" ? "active" : "")">
                                <a class="nav-link" asp-controller="Reports" asp-action="DepartmentWise">
                                    <i class="bi bi-diagram-3"></i>
                                    <span>Department Wise</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "FundWise" ? "active" : "")">
                                <a class="nav-link" asp-controller="Reports" asp-action="FundWise">
                                    <i class="bi bi-wallet2"></i>
                                    <span>Fund Wise</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "CostCenterWise" ? "active" : "")">
                                <a class="nav-link" asp-controller="Reports" asp-action="CostCenterWise">
                                    <i class="bi bi-building"></i>
                                    <span>Cost Center Wise</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ObjectWise" ? "active" : "")">
                                <a class="nav-link" asp-controller="Reports" asp-action="ObjectWise">
                                    <i class="bi bi-box-seam"></i>
                                    <span>Object Wise</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "FunctionWise" ? "active" : "")" style="display:none;">
                                <a class="nav-link" asp-controller="Reports" asp-action="FunctionWise">
                                    <i class="bi bi-grid-3x3-gap"></i>
                                    <span>Function Wise</span>
                                </a>
                            </li>
                            <li class="nav-item d-none @(ViewContext.RouteData.Values["action"]?.ToString() == "CompleteBudget" ? "active" : "")">
                                <a class="nav-link" asp-controller="Reports" asp-action="CompleteBudget">
                                    <i class="bi bi-file-earmark-bar-graph"></i>
                                    <span>Complete Budget</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "DevBudget" ? "active" : "")">
                                <a class="nav-link" asp-controller="Reports" asp-action="DevBudget">
                                    <i class="bi bi-building-gear"></i>
                                    <span>Dev Budget</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item" style="display:none;">
                        <a class="nav-link" href="#originalBudgetSubmenu" data-bs-toggle="collapse" role="button" aria-expanded="true" aria-controls="originalBudgetSubmenu" id="originalBudgetToggle">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Original Budget</span>
                            <i class="bi bi-chevron-down ms-auto small"></i>
                        </a>
                        <ul class="collapse list-unstyled show" id="originalBudgetSubmenu">
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "OriginalBudget" ? "active" : "")">
                                <a class="nav-link" asp-controller="BudgetAnalysis" asp-action="OriginalBudget">
                                    <i class="bi bi-speedometer2"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "CostCenterReport" ? "active" : "")">
                                <a class="nav-link" asp-controller="BudgetAnalysis" asp-action="CostCenterReport">
                                    <i class="bi bi-building"></i>
                                    <span>Cost Center Report</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Comparison" ? "active" : "")" style="display:none;">
                        <a class="nav-link" asp-controller="BudgetAnalysis" asp-action="Comparison">
                            <i class="bi bi-arrow-left-right"></i>
                            <span>Budget Comparison</span>
                        </a>
                    </li>

                    @if (!User.IsInRole("DepartmentUser"))
                    {
                        <li class="nav-section-title">Summary Reports</li>
                        <li class="nav-item">
                            <a class="nav-link" href="#summaryReportsSubmenu" data-bs-toggle="collapse" role="button" aria-expanded="true" aria-controls="summaryReportsSubmenu">
                                <i class="bi bi-clipboard2-data"></i>
                                <span>Summary Reports</span>
                                <i class="bi bi-chevron-down ms-auto small"></i>
                            </a>
                            <ul class="collapse list-unstyled show" id="summaryReportsSubmenu">
                                <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "NineItemsReport" ? "active" : "")">
                                    <a class="nav-link" asp-controller="SummaryReports" asp-action="NineItemsReport">
                                        <i class="bi bi-9-square"></i>
                                        <span>9 Items Report</span>
                                    </a>
                                </li>
                                <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "DeptWiseReport" ? "active" : "")">
                                    <a class="nav-link" asp-controller="SummaryReports" asp-action="DeptWiseReport">
                                        <i class="bi bi-diagram-3"></i>
                                        <span>Dept Wise Report</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                    @if (User.IsInRole("SNEDepartmentUser") && !User.IsInRole("Administrator") && User.IsInRole("DepartmentUser"))
                    {
                        <li class="nav-section-title">Permanent Budget</li>
                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sne" ? "active" : "")">
                            <a class="nav-link" asp-controller="Sne" asp-action="Index">
                                <i class="bi bi-file-earmark-spreadsheet"></i>
                                <span>Permanent Budget</span>
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-section-title">Import</li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "UploadOriginalBudget" ? "active" : "")">
                            <a class="nav-link" asp-controller="Import" asp-action="UploadOriginalBudget">
                                <i class="bi bi-upload"></i>
                                <span>Upload Original Budget</span>
                            </a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "UploadBER" ? "active" : "")">
                            <a class="nav-link" asp-controller="Import" asp-action="UploadBER">
                                <i class="bi bi-upload"></i>
                                <span>Upload BER</span>
                            </a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "UploadYpProject" ? "active" : "")">
                            <a class="nav-link" asp-controller="Import" asp-action="UploadYpProject">
                                <i class="bi bi-upload"></i>
                                <span>Upload YpProject</span>
                            </a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "UploadPnDFile" ? "active" : "")">
                            <a class="nav-link" asp-controller="Import" asp-action="UploadPnDFile">
                                <i class="bi bi-upload"></i>
                                <span>Upload PnD File</span>
                            </a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")">
                            <a class="nav-link" asp-controller="Import" asp-action="History">
                                <i class="bi bi-clock-history"></i>
                                <span>Import History</span>
                            </a>
                        </li>

                        <li class="nav-section-title">Administration</li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                            <a class="nav-link" asp-controller="Administration" asp-action="Users">
                                <i class="bi bi-people"></i>
                                <span>Users</span>
                            </a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")">
                            <a class="nav-link" asp-controller="Administration" asp-action="Roles">
                                <i class="bi bi-shield-lock"></i>
                                <span>Roles</span>
                            </a>
                        </li>
                        <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")">
                            <a class="nav-link" asp-controller="Administration" asp-action="AuditLogs">
                                <i class="bi bi-journal-text"></i>
                                <span>Audit Logs</span>
                            </a>
                        </li>

                        <li class="nav-section-title">Permanent Budget</li>
                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sne" ? "active" : "")">
                            <a class="nav-link" asp-controller="Sne" asp-action="Index">
                                <i class="bi bi-file-earmark-spreadsheet"></i>
                                <span>Permanent Budget</span>
                            </a>
                        </li>
                    }
                    }
                </ul>

                <div class="sidebar-footer">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-grid">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm mx-3">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </form>
                </div>
            </nav>
        }

        <!-- Page Content -->
        <div id="content" class="content">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Top Navbar -->
                <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
                    <div class="container-fluid">
                        <button type="button" id="sidebarCollapse" class="btn btn-outline-primary">
                            <i class="bi bi-list"></i>
                        </button>

                        <span class="navbar-brand ms-3 mb-0 h5 d-none d-md-block">
                            <i class="bi bi-bank2 text-primary me-2"></i>
                            Finance Department Punjab - Budget Analysis
                        </span>

                        <div class="ms-auto d-flex align-items-center">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary dropdown-toggle btn-sm" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i>
                                    <span class="d-none d-md-inline">@User.Identity?.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>
            }

            <!-- Main Content -->
            <main class="main-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer mt-auto py-3 bg-white border-top">
                <div class="container-fluid text-center">
                    <span class="text-muted">
                        &copy; @DateTime.Now.Year Finance Department Punjab. All rights reserved.
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    <script>
        // Restore sidebar state on load
        (function () {
            var sidebar = document.getElementById('sidebar');
            var content = document.getElementById('content');
            if (sidebar && localStorage.getItem('sidebar-collapsed') === 'true') {
                sidebar.classList.add('collapsed');
                content?.classList.add('expanded');
            }
        })();

        // Sidebar toggle
        document.getElementById('sidebarCollapse')?.addEventListener('click', function () {
            var sidebar = document.getElementById('sidebar');
            var content = document.getElementById('content');
            sidebar.classList.toggle('collapsed');
            content.classList.toggle('expanded');
            localStorage.setItem('sidebar-collapsed', sidebar.classList.contains('collapsed'));
        });

        // Toast helper functions
        function showToast(type, message) {
            const toastEl = document.getElementById('toast-' + type);
            if (toastEl) {
                document.getElementById('toast-' + type + '-msg').textContent = message;
                const toast = new bootstrap.Toast(toastEl);
                toast.show();
            }
        }

        // Loading spinner helpers
        function showLoading() {
            document.getElementById('loading-overlay').classList.remove('d-none');
        }

        function hideLoading() {
            document.getElementById('loading-overlay').classList.add('d-none');
        }

        // Format currency
        function formatCurrency(value) {
            return new Intl.NumberFormat('en-PK', {
                style: 'currency',
                currency: 'PKR',
                minimumFractionDigits: 2
            }).format(value);
        }

        // Format number
        function formatNumber(value) {
            return new Intl.NumberFormat('en-PK').format(value);
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
