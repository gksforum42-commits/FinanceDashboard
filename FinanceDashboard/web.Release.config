<?xml version="1.0" encoding="utf-8"?>
<!--
  This transform is applied ONLY when publishing in Release mode.
  It adds requestTimeout="01:00:00" (1 hour) to the live IIS server
  so long-running BER uploads do not get killed mid-request.
  DO NOT add requestTimeout to web.config directly — it crashes IIS Express locally.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.webServer>
	<aspNetCore xdt:Transform="SetAttributes"
				requestTimeout="01:00:00" />
  </system.webServer>
</configuration>
